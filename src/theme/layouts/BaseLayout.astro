---
import { createOpenGraphTags } from '../../open-graph.js';
import type { OpenGraphOptions } from '../../open-graph.js';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { alternateRoute, localize } from '../../compiler/localization.js';
import * as Analytics from 'astro-analytics';
import languageIcon from '../assets/icons/language.svg?raw';
import menuIcon from '@tabler/icons/outline/menu-2.svg?raw';
import SiteFooter from '../components/SiteFooter.astro';
import { defaultFooterGroups } from '../lib/footer';
import SiteSearch from '../components/SiteSearch.astro';
import Loading from '../components/Loading.astro';
import ProductMenu from '../components/ProductMenu.astro';
import AntVHeaderActions from '../components/AntVHeaderActions.astro';
import Announcement from '../components/Announcement.astro';
import { withBase } from '../lib/paths';
import { getGeneratedRoutes } from '../lib/routes';
import { config } from '../lib/site';
import '../styles/global.css';
import '../styles/tailwind.css';

interface Props {
  locale: 'zh' | 'en';
  title: string;
  description: string;
  route: string;
  pageType?: string;
  image?: string;
  imageAlt?: string;
  openGraph?: OpenGraphOptions;
}

const { locale, title, description, route, pageType = 'page', image, imageAlt, openGraph } = Astro.props;
const canonical = new URL(withBase(route), config.site.origin);
const documentTitle = title === config.site.title ? title : `${title} · ${config.site.title}`;
const openGraphTags = createOpenGraphTags({
  site: config.site,
  locale,
  title: documentTitle,
  description,
  canonical: canonical.href,
  base: import.meta.env.BASE_URL,
  type: pageType === 'document' ? 'article' : 'website',
  image,
  imageAlt,
  openGraph,
});
// Index the localized homepage once; the root URL renders the same content.
const isRootHome = pageType === 'home' && Astro.url.pathname === withBase('/');
const generatedRoutes = await getGeneratedRoutes();
const alternateLocales = config.site.locales
  .map((candidateLocale) => ({
    locale: candidateLocale,
    route: alternateRoute(route, candidateLocale),
  }))
  .filter((entry) => generatedRoutes.has(entry.route));
const localeSwitch = alternateLocales.find((entry) => entry.locale !== locale);
const defaultAlternate = alternateLocales.find(
  (entry) => entry.locale === config.site.defaultLocale,
);
const hasScheme = (href: string) => /^[a-z][a-z\d+.-]*:/i.test(href);
const localizedRoute = (href: string) => {
  if (href.startsWith('//') || hasScheme(href)) return href;
  if (href.startsWith('#')) return href;
  if (href.startsWith('/#')) return `/${locale}/${href.slice(1)}`;
  if (href.startsWith(`/${locale}/`)) return href;
  return `/${locale}${href.startsWith('/') ? href : `/${href}`}`.replace(/\/$/, '') + '/';
};
const localHref = (href: string) => withBase(localizedRoute(href));
const navLabel = locale === 'zh' ? '主导航' : 'Primary navigation';
const currentSection = route.replace(new RegExp(`^/${locale}/?`), '').split('/')[0];
const navigation = config.navigation.map((item) => {
  const href = localHref(item.href);
  const section = item.href.replace(/^\//, '').split('/')[0];
  return {
    ...item,
    href,
    active: section ? currentSection === section : route === localizedRoute(item.href),
  };
});
const versionEntries = Object.entries(config.versions);
const currentVersion = versionEntries[0]?.[0];
const isAntVSite = config.site.title.trim().toLocaleLowerCase() === 'antv';
const searchEnabled = config.search.enabled;
const footerHref = config.footer.groups === null ? withBase : localHref;
const footerGroups = (config.footer.groups ?? defaultFooterGroups).map((group) => ({
  ...group,
  links: group.links.map((link) => ({ ...link, href: footerHref(link.href) })),
}));
const serializedTokens = Object.entries(config.theme.tokens)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');
const themeOverrides = serializedTokens && `:root{${serializedTokens}}`;
const copyright = localize(
  config.footer.copyright,
  locale,
  `© Copyright ${new Date().getFullYear()} Ant Group Co., Ltd..备案号：京ICP备15032932号-38`,
);
const footerTagline = localize(
  config.footer.tagline,
  locale,
  '',
);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': pageType === 'document' ? 'TechArticle' : 'WebPage',
  name: title,
  description,
  url: canonical.href,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: config.site.title,
    url: new URL(withBase('/'), config.site.origin).href,
  },
};
---

<!doctype html>
<html lang={locale} data-site-title={config.site.title}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {Object.entries(openGraphTags).map(([property, content]) => <meta property={property} content={content} />)}
    <meta name="generator" content="@antv/astro-theme-antv" />
    <meta name="color-scheme" content="light" />
    <link rel="stylesheet" href="https://assets.antv.antgroup.com/AlibabaPuHuiTi-Regular/result.css" />
    <link rel="stylesheet" href="https://assets.antv.antgroup.com/AlibabaPuHuiTi-Bold/result.css" />
    <link rel="canonical" href={canonical} />
    <link rel="help" type="text/plain" href={withBase('/llms.txt')} title="Agent resources" />
    {alternateLocales.map((entry) => (
      <link
        rel="alternate"
        hreflang={entry.locale === 'zh' ? 'zh-CN' : 'en'}
        href={new URL(withBase(entry.route), config.site.origin)}
      />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={new URL(withBase(defaultAlternate.route), config.site.origin)} />
    )}
    {config.site.favicon && <link rel="icon" href={withBase(config.site.favicon)} />}
    <title>{documentTitle}</title>
    {themeOverrides && <style is:inline set:html={themeOverrides} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class:list={[`page-${pageType}`, isAntVSite && 'antv-site']}>
    <a class="skip-link" href="#main-content">
      {locale === 'zh' ? '跳到主要内容' : 'Skip to content'}
    </a>
    <Loading locale={locale} page />
    <div class="site-canvas">
    <Announcement locale={locale} />
    <header class:list={['site-header', pageType === 'home' && 'home-header', isAntVSite && 'antv-site-header']} data-pagefind-ignore>
      <div class="header-inner">
        <a class="brand inline-flex items-center h-full text-[var(--text-strong)] whitespace-nowrap" href={withBase(`/${locale}/`)} aria-label={`${config.site.title} home`}>
          {config.site.logo ? (
            <img class="brand-logo w-auto h-7.5 object-contain" src={withBase(config.site.logo)} alt="AntV" />
          ) : (
            <span class="brand-wordmark text-[var(--text-strong)] text-[20px] font-bold" aria-hidden="true">AntV</span>
          )}
          {!isAntVSite && <span class="brand-divider w-[1px] h-6 mx-5 my-0 [@media(width<=700px)]:mx-3" aria-hidden="true"></span>}
          {!isAntVSite && <span class="brand-product text-[var(--text-strong)] text-[18px] font-medium [@media(width<=700px)]:text-[16px]">{config.site.title}</span>}
        </a>
        <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={locale === 'zh' ? '菜单' : 'Menu'}>
          <span aria-hidden="true" set:html={menuIcon}></span>
        </button>
        <nav id="primary-nav" class="primary-nav" aria-label={navLabel}>
          {navigation.map((item) => (
            <a href={item.href} aria-current={item.active ? 'page' : undefined}>{localize(item.text, locale)}</a>
          ))}
          <ProductMenu locale={locale} />
          {versionEntries.length > 0 && (
            <details class="header-menu version-menu">
              <summary>
                <span>{currentVersion}</span>
                <span class="nav-chevron" aria-hidden="true"></span>
              </summary>
              <div>
                {versionEntries.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
              </div>
            </details>
          )}
          {searchEnabled && (
            <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
              <span class="nav-search-icon" aria-hidden="true"></span>
              <span>{locale === 'zh' ? '搜索文档' : 'Search docs'}</span>
              <kbd>⌘ K</kbd>
            </button>
          )}
          {localeSwitch && (
            <a
              class="nav-icon-action"
              href={withBase(localeSwitch.route)}
              hreflang={localeSwitch.locale}
              aria-label={localeSwitch.locale === 'en' ? 'Switch to English' : '切换到中文'}
              title={localeSwitch.locale === 'en' ? 'Switch to English' : '切换到中文'}
            >
              <span class="nav-action-icon block w-5 h-5 [flex:0_0_20px] [&_svg]:block [&_svg]:w-full [&_svg]:h-full [&_svg]:[stroke-width:1.8]" aria-hidden="true" set:html={languageIcon}></span>
              <span class="nav-icon-label hidden [@media(width<=900px)]:inline">{localeSwitch.locale === 'en' ? 'English' : '中文'}</span>
            </a>
          )}
          <AntVHeaderActions locale={locale} repository={config.site.repository} />
        </nav>
      </div>
    </header>
    <main id="main-content" data-pagefind-body={isRootHome ? undefined : true}>
      <slot />
    </main>
    <SiteFooter
      locale={locale}
      groups={footerGroups}
      description={localize(config.footer.description, locale)}
      copyright={copyright}
      tagline={footerTagline}
    />
    </div>
    {searchEnabled && (
      <SiteSearch
        locale={locale}
        siteTitle={config.site.title}
        aliases={config.search.aliases}
        pathBoosts={config.search.pathBoosts}
      />
    )}
    <script is:inline>
      (() => {
        const navButton = document.querySelector('.mobile-nav-toggle');
        const nav = document.querySelector('#primary-nav');
        const header = document.querySelector('.site-header');
        const updateNavPosition = () => {
          if (nav.hasAttribute('data-open')) {
            nav.style.setProperty('--mobile-nav-top', `${header.getBoundingClientRect().bottom}px`);
          }
        };
        const setNavOpen = (open) => {
          navButton.setAttribute('aria-expanded', String(open));
          nav.toggleAttribute('data-open', open);
          document.body.classList.toggle('mobile-nav-open', open);
          updateNavPosition();
          if (!open) nav.querySelectorAll('details[open]').forEach((menu) => menu.removeAttribute('open'));
        };
        navButton.addEventListener('click', () => {
          const open = navButton.getAttribute('aria-expanded') === 'true';
          setNavOpen(!open);
        });
        nav.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) setNavOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
            setNavOpen(false);
            navButton.focus();
          }
        });
        window.matchMedia('(max-width: 900px)').addEventListener('change', () => {
          setNavOpen(false);
        });
        window.addEventListener('resize', updateNavPosition);
        const navPositionObserver = new ResizeObserver(updateNavPosition);
        navPositionObserver.observe(document.querySelector('.site-canvas'));

        const copyLabels = document.documentElement.lang === 'zh'
          ? { idle: '复制代码', success: '已复制', error: '复制失败' }
          : { idle: 'Copy code', success: 'Copied', error: 'Copy failed' };
        const setupCopy = (button, readContent) => {
          const label = button.querySelector('[data-copy-label]');
          const idleTitle = button.title;
          const idleLabel = label?.textContent || idleTitle;
          const setCopyState = (state) => {
            const text = state === 'idle' ? idleLabel : copyLabels[state];
            button.dataset.copyState = state;
            button.title = state === 'idle' ? idleTitle : text;
            button.setAttribute('aria-label', text);
            if (label) label.textContent = text;
          };
          let resetTimer;
          button.addEventListener('click', async () => {
            clearTimeout(resetTimer);
            button.disabled = true;
            setCopyState('idle');
            try {
              await navigator.clipboard.writeText(await readContent());
              setCopyState('success');
            } catch {
              setCopyState('error');
            } finally {
              button.disabled = false;
              resetTimer = setTimeout(() => { setCopyState('idle'); }, 1800);
            }
          });
        };
        document.querySelectorAll('[data-copy-document]').forEach((button) => {
          button.hidden = false;
          setupCopy(button, async () => {
            const response = await fetch(button.dataset.copyDocument, { signal: AbortSignal.timeout(10000) });
            if (!response.ok || response.headers.get('content-type')?.includes('text/html')) {
              throw new Error('Unable to load document Markdown.');
            }
            return response.text();
          });
        });
        document.querySelectorAll('.markdown-body pre').forEach((pre) => {
          const code = pre.querySelector(':scope > code');
          if (!code || pre.closest('.markdown-code-block') || pre.hasAttribute('data-demo-source')) return;
          const wrapper = document.createElement('div');
          wrapper.className = 'markdown-code-block';
          pre.before(wrapper);
          wrapper.append(pre);

          const button = document.createElement('button');
          button.className = 'markdown-code-copy';
          button.type = 'button';
          button.setAttribute('aria-label', copyLabels.idle);
          button.title = copyLabels.idle;
          button.innerHTML = `
            <svg class="markdown-code-copy-icon is-copy" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="14" height="14" rx="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg class="markdown-code-copy-icon is-success" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          `;
          wrapper.append(button);

          setupCopy(button, () => code.textContent || '');
        });

      })();
    </script>
    {import.meta.env.PROD && Object.entries(config.analytics).map(([name, props]) => {
      if (!Object.hasOwn(Analytics, name)) {
        throw new Error(`Unknown analytics component "${name}". Use an export from astro-analytics.`);
      }
      const Component = Analytics[name as keyof typeof Analytics] as AstroComponentFactory;
      return <Component {...props} />;
    })}
  </body>
</html>
