---
import { createOpenGraphTags } from '../../open-graph.js';
import type { OpenGraphOptions } from '../../open-graph.js';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { alternateRoute, localize } from '../../compiler/localization.js';
import * as Analytics from 'astro-analytics';
import languageIcon from '../assets/icons/language.svg?raw';
import menuIcon from '@tabler/icons/outline/menu-2.svg?raw';
import searchIcon from '@tabler/icons/outline/search.svg?raw';
import SiteFooter from '../components/SiteFooter.astro';
import { defaultFooterGroups } from '../lib/footer';
import SiteSearch from '../components/SiteSearch.astro';
import Loading from '../components/Loading.astro';
import ProductMenu from '../components/ProductMenu.astro';
import AntVHeaderActions from '../components/AntVHeaderActions.astro';
import Announcement from '../components/Announcement.astro';
import { withBase } from '../lib/paths';
import { getGeneratedRoutes } from '../lib/routes';
import { config } from '../lib/site';
import '../styles/global.css';
import '../styles/tailwind.css';

interface Props {
  locale: 'zh' | 'en';
  title: string;
  description: string;
  route: string;
  pageType?: string;
  image?: string;
  imageAlt?: string;
  openGraph?: OpenGraphOptions;
}

const { locale, title, description, route, pageType = 'page', image, imageAlt, openGraph } = Astro.props;
const canonical = new URL(withBase(route), config.site.origin);
const documentTitle = title === config.site.title ? title : `${title} · ${config.site.title}`;
const openGraphTags = createOpenGraphTags({
  site: config.site,
  locale,
  title: documentTitle,
  description,
  canonical: canonical.href,
  base: import.meta.env.BASE_URL,
  type: pageType === 'document' ? 'article' : 'website',
  image,
  imageAlt,
  openGraph,
});
// Index the localized homepage once; the root URL renders the same content.
const isRootHome = pageType === 'home' && Astro.url.pathname === withBase('/');
const generatedRoutes = await getGeneratedRoutes();
const alternateLocales = config.site.locales
  .map((candidateLocale) => ({
    locale: candidateLocale,
    route: alternateRoute(route, candidateLocale),
  }))
  .filter((entry) => generatedRoutes.has(entry.route));
const localeSwitch = alternateLocales.find((entry) => entry.locale !== locale);
const defaultAlternate = alternateLocales.find(
  (entry) => entry.locale === config.site.defaultLocale,
);
const hasScheme = (href: string) => /^[a-z][a-z\d+.-]*:/i.test(href);
const localizedRoute = (href: string) => {
  if (href.startsWith('//') || hasScheme(href)) return href;
  if (href.startsWith('#')) return href;
  if (href.startsWith('/#')) return `/${locale}/${href.slice(1)}`;
  if (href.startsWith(`/${locale}/`)) return href;
  return `/${locale}${href.startsWith('/') ? href : `/${href}`}`.replace(/\/$/, '') + '/';
};
const localHref = (href: string) => withBase(localizedRoute(href));
const navLabel = locale === 'zh' ? '主导航' : 'Primary navigation';
const currentSection = route.replace(new RegExp(`^/${locale}/?`), '').split('/')[0];
const navigation = config.navigation.map((item) => {
  const href = localHref(item.href);
  const section = item.href.replace(/^\//, '').split('/')[0];
  return {
    ...item,
    href,
    active: section ? currentSection === section : route === localizedRoute(item.href),
  };
});
const versionEntries = Object.entries(config.versions);
const currentVersion = versionEntries[0]?.[0];
const isAntVSite = config.site.title.trim().toLocaleLowerCase() === 'antv';
const searchEnabled = config.search.enabled;
// The layout owns the page canvas, including the default product homepage.
const homeBackgroundClass = pageType === 'home' && !isAntVSite
  ? '[background:radial-gradient(circle_at_74%_8%,color-mix(in_srgb,var(--brand)_10%,transparent),transparent_32%),radial-gradient(circle_at_12%_28%,color-mix(in_srgb,#8aa7ff_8%,transparent),transparent_28%),var(--home-background)]'
  : '';
const footerHref = config.footer.groups === null ? withBase : localHref;
const footerGroups = (config.footer.groups ?? defaultFooterGroups).map((group) => ({
  ...group,
  links: group.links.map((link) => ({ ...link, href: footerHref(link.href) })),
}));
const serializedTokens = Object.entries(config.theme.tokens)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');
const themeOverrides = serializedTokens && `:root{${serializedTokens}}`;
const copyright = localize(
  config.footer.copyright,
  locale,
  `© Copyright ${new Date().getFullYear()} Ant Group Co., Ltd..备案号：京ICP备15032932号-38`,
);
const footerTagline = localize(
  config.footer.tagline,
  locale,
  '',
);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': pageType === 'document' ? 'TechArticle' : 'WebPage',
  name: title,
  description,
  url: canonical.href,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: config.site.title,
    url: new URL(withBase('/'), config.site.origin).href,
  },
};
const navItemClass = [
  'inline-flex items-center h-full m-0 py-0 border-0 rounded-none bg-transparent shadow-none text-[#697b8c] [font-family:inherit] text-[14px] font-normal tracking-normal no-underline cursor-pointer [transition:color_0.3s,box-shadow_0.3s] hover:text-[var(--brand)] aria-[current=page]:shadow-[inset_0_2px_0_var(--brand)] aria-[current=page]:text-[var(--brand-strong)]',
  '[@media(width<=900px)]:w-full [@media(width<=900px)]:min-h-[58px] [@media(width<=900px)]:h-auto [@media(width<=900px)]:px-6 [@media(width<=900px)]:text-[16px] [@media(width<=900px)]:aria-[current=page]:bg-[var(--brand-soft)] [@media(width<=900px)]:aria-[current=page]:shadow-none',
  isAntVSite && pageType === 'home'
    ? '[@media(width>=901px)]:h-8 [@media(width>=901px)]:px-3 [@media(width>=901px)]:rounded-md [@media(width>=901px)]:text-[#424e66] [@media(width>=901px)]:text-[16px] [@media(width>=901px)]:shadow-none [@media(width>=901px)]:hover:text-[#424e66] [@media(width>=901px)]:hover:bg-white [@media(width>=901px)]:hover:shadow-[0_2px_5px_rgb(0_0_0/10%)]'
    : '[@media(width>1320px)]:px-[9px] [@media(900px<width<=1320px)]:px-2',
].join(' ');

---

<!doctype html>
<html lang={locale} data-site-title={config.site.title}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {Object.entries(openGraphTags).map(([property, content]) => <meta property={property} content={content} />)}
    <meta name="generator" content="@antv/astro-theme-antv" />
    <meta name="color-scheme" content="light" />
    <link rel="stylesheet" href="https://assets.antv.antgroup.com/AlibabaPuHuiTi-Regular/result.css" />
    <link rel="stylesheet" href="https://assets.antv.antgroup.com/AlibabaPuHuiTi-Bold/result.css" />
    <link rel="canonical" href={canonical} />
    <link rel="help" type="text/plain" href={withBase('/llms.txt')} title="Agent resources" />
    {alternateLocales.map((entry) => (
      <link
        rel="alternate"
        hreflang={entry.locale === 'zh' ? 'zh-CN' : 'en'}
        href={new URL(withBase(entry.route), config.site.origin)}
      />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={new URL(withBase(defaultAlternate.route), config.site.origin)} />
    )}
    {config.site.favicon && <link rel="icon" href={withBase(config.site.favicon)} />}
    <title>{documentTitle}</title>
    {themeOverrides && <style is:inline set:html={themeOverrides} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class:list={[`page-${pageType}`, isAntVSite && 'antv-site', homeBackgroundClass, pageType === 'qa' && 'h-dvh min-h-dvh overflow-hidden', '[@media(width<=900px)]:[&.mobile-nav-open]:overflow-hidden']}>
    <a class="fixed top-2.5 left-2.5 z-500 py-2.5 px-3.5 rounded-[var(--radius-small)] bg-[var(--text-strong)] text-[var(--surface)] [transform:translateY(-160%)] focus:transform-none" href="#main-content">
      {locale === 'zh' ? '跳到主要内容' : 'Skip to content'}
    </a>
    <Loading locale={locale} page />
    <div class:list={["site-canvas min-h-dvh", homeBackgroundClass || "bg-[var(--surface-raised)]", pageType === 'demo' && "[@media(width>1080px)]:flex [@media(width>1080px)]:h-dvh [@media(width>1080px)]:flex-col [@media(width>1080px)]:overflow-hidden [&>header]:shrink-0 [&>antv-announcement]:shrink-0"]}>
    <Announcement locale={locale} />
    <header class:list={['site-header top-0 z-200 h-[var(--header-height)] [border-bottom:1px_solid_var(--border-soft)] [transition:background_0.3s,box-shadow_0.3s]', pageType === 'home' ? 'home-header shadow-none' : 'sticky bg-[color-mix(in_srgb,var(--surface-raised)_96%,transparent)] shadow-[var(--header-shadow,0_2px_8px_#f0f1f2)]', pageType === 'home' && (isAntVSite ? 'relative mb-[calc(-1*var(--header-height))] border-b-black/10 bg-transparent has-[[data-products-menu][open]]:bg-[var(--surface-raised)] has-[#primary-nav[data-open]]:bg-[var(--surface-raised)] has-[#primary-nav[data-open]]:sticky' : 'sticky bg-[var(--home-background)]'), isAntVSite && 'antv-site-header']} data-pagefind-ignore>
      <div class:list={["flex items-center justify-between h-full mx-auto py-0", isAntVSite && pageType === "home" ? "w-full px-5" : "w-[var(--content-width)] [@media(width<=900px)]:w-[calc(100%_-_32px)]", pageType !== "home" ? "px-10 [@media(width<=900px)]:px-0" : !isAntVSite && "px-6"]}>
        <a class="brand inline-flex items-center h-full text-[var(--text-strong)] whitespace-nowrap" href={withBase(`/${locale}/`)} aria-label={`${config.site.title} home`}>
          {config.site.logo ? (
            <img class="brand-logo w-auto h-7.5 object-contain" src={withBase(config.site.logo)} alt="AntV" />
          ) : (
            <span class="brand-wordmark text-[var(--text-strong)] text-[20px] font-bold" aria-hidden="true">AntV</span>
          )}
          {!isAntVSite && <span class="bg-[var(--border-strong)] w-[1px] h-6 mx-5 my-0 [@media(width<=700px)]:mx-3" aria-hidden="true"></span>}
          {!isAntVSite && <span class="brand-product text-[var(--text-strong)] text-[18px] font-medium [@media(width<=700px)]:text-[16px]">{config.site.title}</span>}
        </a>
        {searchEnabled && (
          <button
            class="inline-flex h-10 min-w-0 shrink-0 items-center gap-2 ml-8 mr-auto border-0 bg-transparent p-0 text-[14px] text-[var(--muted-light)] cursor-pointer hover:text-[var(--brand)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current [@media(width<=1080px)]:ml-4"
            type="button"
            data-search-open
            aria-haspopup="dialog"
            aria-label={locale === 'zh' ? '搜索文档' : 'Search docs'}
            title={locale === 'zh' ? '搜索文档 (⌘ K / Ctrl K)' : 'Search docs (⌘ K / Ctrl K)'}
          >
            <span class="inline-flex size-4 [&_svg]:size-full" aria-hidden="true" set:html={searchIcon} />
            <span>{locale === 'zh' ? '搜索…' : 'Search…'}</span>
          </button>
        )}
        <button data-mobile-nav-toggle class="hidden [@media(width<=900px)]:inline-flex items-center justify-center size-10 p-2 border-0 rounded-md bg-transparent text-[var(--text)] cursor-pointer [&_span]:block [&_span]:size-6 [&_svg]:block [&_svg]:size-6" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={locale === 'zh' ? '菜单' : 'Menu'}>
          <span aria-hidden="true" set:html={menuIcon}></span>
        </button>
        <nav id="primary-nav" class="flex items-center gap-2 h-full text-[var(--muted)] whitespace-nowrap [@media(width<=900px)]:fixed [@media(width<=900px)]:top-[var(--mobile-nav-top,var(--header-height))] [@media(width<=900px)]:inset-x-0 [@media(width<=900px)]:hidden [@media(width<=900px)]:h-[calc(100dvh_-_var(--mobile-nav-top,var(--header-height)))] [@media(width<=900px)]:flex-col [@media(width<=900px)]:items-stretch [@media(width<=900px)]:pt-2 [@media(width<=900px)]:pb-6 [@media(width<=900px)]:px-0 [@media(width<=900px)]:overflow-auto [@media(width<=900px)]:bg-[var(--surface-raised)] [@media(width<=900px)]:shadow-[var(--header-shadow)] [@media(width<=900px)]:data-open:flex" aria-label={navLabel}>
          {navigation.map((item) => (
            <a class={navItemClass} href={item.href} aria-current={item.active ? 'page' : undefined}>{localize(item.text, locale)}</a>
          ))}
          <ProductMenu locale={locale} summaryClass={navItemClass} />
          {versionEntries.length > 0 && (
            <details class="relative h-full [@media(900px<width<=1080px)]:hidden [@media(width<=900px)]:block [@media(width<=900px)]:w-full [@media(width<=900px)]:h-auto [.antv-site-header.home-header_&]:[@media(width>=901px)]:flex [.antv-site-header.home-header_&]:[@media(width>=901px)]:items-center [&>summary]:gap-[7px] [@media(width<=900px)]:[&>summary]:justify-between [&>summary]:list-none [&>summary::-webkit-details-marker]:hidden">
              <summary class={navItemClass}>
                <span>{currentVersion}</span>
                <span class="size-[7px] [border-right:1.5px_solid_currentColor] [border-bottom:1.5px_solid_currentColor] text-[var(--muted-light)] [transform:translateY(-2px)_rotate(45deg)] origin-center [transition:transform_0.2s_ease] [[open]>summary_&]:[transform:translateY(2px)_rotate(225deg)]" aria-hidden="true"></span>
              </summary>
              <div class="[@media(width<=900px)]:static [@media(width<=900px)]:[border-width:1px_0] [@media(width<=900px)]:rounded-none [@media(width<=900px)]:shadow-none absolute top-[54px] right-0 grid min-w-30 p-2 [border:1px_solid_var(--border)] rounded-[var(--radius-medium)] bg-[var(--surface-raised)] shadow-[var(--shadow-soft)] [&_a]:py-2 [&_a]:px-2.5 [&_a]:rounded-[var(--radius-small)] [&_a]:text-[var(--text)] [&_a:hover]:bg-[var(--brand-soft)] [&_a:hover]:text-[var(--brand-strong)]">
                {versionEntries.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
              </div>
            </details>
          )}
          {localeSwitch && (
            <a
              data-nav-icon
              class:list={[
                'inline-flex items-center justify-center size-8 m-0 p-0 border-0 bg-transparent shadow-none font-normal tracking-normal no-underline cursor-pointer [transition:background_0.2s,color_0.2s,transform_0.2s] active:[transform:scale(0.96)]',
                '[@media(width<=900px)]:w-full [@media(width<=900px)]:min-h-[58px] [@media(width<=900px)]:justify-start [@media(width<=900px)]:gap-3 [@media(width<=900px)]:px-6 [@media(width<=900px)]:rounded-none [@media(width<=900px)]:text-[16px]',
                isAntVSite && pageType === 'home'
                  ? 'rounded-md text-[#424e66] text-[16px] hover:text-[#424e66] hover:bg-white hover:shadow-[0_2px_5px_rgb(0_0_0/10%)] [@media(width<=900px)]:text-[var(--muted)] [@media(width<=900px)]:hover:text-[var(--brand-strong)] [@media(width<=900px)]:hover:bg-[var(--brand-soft)] [@media(width<=900px)]:hover:shadow-none'
                  : 'rounded-[var(--radius-small)] text-[var(--muted)] text-[14px] hover:bg-[var(--brand-soft)] hover:text-[var(--brand-strong)]',
              ]}
              href={withBase(localeSwitch.route)}
              hreflang={localeSwitch.locale}
              aria-label={localeSwitch.locale === 'en' ? 'Switch to English' : '切换到中文'}
              title={localeSwitch.locale === 'en' ? 'Switch to English' : '切换到中文'}
            >
              <span class="nav-action-icon block w-5 h-5 [flex:0_0_20px] [&_svg]:block [&_svg]:w-full [&_svg]:h-full [&_svg]:[stroke-width:1.8]" aria-hidden="true" set:html={languageIcon}></span>
              <span class="nav-icon-label hidden [@media(width<=900px)]:inline">{localeSwitch.locale === 'en' ? 'English' : '中文'}</span>
            </a>
          )}
          <AntVHeaderActions locale={locale} repository={config.site.repository} />
        </nav>
      </div>
    </header>
    <main id="main-content" class:list={[pageType === 'home' && "overflow-hidden", pageType === 'qa' && "h-[calc(100dvh_-_var(--header-height))] min-h-0 overflow-hidden", pageType === 'demo' && "[@media(width>1080px)]:min-h-0 [@media(width>1080px)]:flex-1"]} data-pagefind-body={isRootHome ? undefined : true}>
      <slot />
    </main>
    {pageType !== 'demo' && pageType !== 'qa' && <SiteFooter
      locale={locale}
      groups={footerGroups}
      description={localize(config.footer.description, locale)}
      copyright={copyright}
      tagline={footerTagline}
    />}
    </div>
    {searchEnabled && (
      <SiteSearch
        locale={locale}
        siteTitle={config.site.title}
        aliases={config.search.aliases}
        pathBoosts={config.search.pathBoosts}
      />
    )}
    <script is:inline>
      (() => {
        const navButton = document.querySelector('[data-mobile-nav-toggle]');
        const nav = document.querySelector('#primary-nav');
        const header = document.querySelector('.site-header');
        const updateNavPosition = () => {
          if (nav.hasAttribute('data-open')) {
            nav.style.setProperty('--mobile-nav-top', `${header.getBoundingClientRect().bottom}px`);
          }
        };
        const setNavOpen = (open) => {
          navButton.setAttribute('aria-expanded', String(open));
          nav.toggleAttribute('data-open', open);
          document.body.classList.toggle('mobile-nav-open', open);
          updateNavPosition();
          if (!open) nav.querySelectorAll('details[open]').forEach((menu) => menu.removeAttribute('open'));
        };
        navButton.addEventListener('click', () => {
          const open = navButton.getAttribute('aria-expanded') === 'true';
          setNavOpen(!open);
        });
        nav.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) setNavOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.hasAttribute('data-open')) {
            setNavOpen(false);
            navButton.focus();
          }
        });
        window.matchMedia('(max-width: 900px)').addEventListener('change', () => {
          setNavOpen(false);
        });
        window.addEventListener('resize', updateNavPosition);
        const navPositionObserver = new ResizeObserver(updateNavPosition);
        navPositionObserver.observe(document.querySelector('.site-canvas'));

        const copyLabels = document.documentElement.lang === 'zh'
          ? { idle: '复制代码', success: '已复制', error: '复制失败' }
          : { idle: 'Copy code', success: 'Copied', error: 'Copy failed' };
        const setupCopy = (button, readContent) => {
          const label = button.querySelector('[data-copy-label]');
          const idleTitle = button.title;
          const idleLabel = label?.textContent || idleTitle;
          const setCopyState = (state) => {
            const text = state === 'idle' ? idleLabel : copyLabels[state];
            button.dataset.copyState = state;
            button.title = state === 'idle' ? idleTitle : text;
            button.setAttribute('aria-label', text);
            if (label) label.textContent = text;
          };
          let resetTimer;
          button.addEventListener('click', async () => {
            clearTimeout(resetTimer);
            button.disabled = true;
            setCopyState('idle');
            try {
              await navigator.clipboard.writeText(await readContent());
              setCopyState('success');
            } catch {
              setCopyState('error');
            } finally {
              button.disabled = false;
              resetTimer = setTimeout(() => { setCopyState('idle'); }, 1800);
            }
          });
        };
        document.querySelectorAll('[data-copy-document]').forEach((button) => {
          button.hidden = false;
          setupCopy(button, async () => {
            const response = await fetch(button.dataset.copyDocument, { signal: AbortSignal.timeout(10000) });
            if (!response.ok || response.headers.get('content-type')?.includes('text/html')) {
              throw new Error('Unable to load document Markdown.');
            }
            return response.text();
          });
        });
        document.querySelectorAll('.markdown-body pre').forEach((pre) => {
          const code = pre.querySelector(':scope > code');
          if (!code || pre.closest('[data-code-block]') || pre.hasAttribute('data-demo-source')) return;
          const wrapper = document.createElement('div');
          wrapper.setAttribute('data-code-block', '');
          wrapper.className = 'group/code-block relative max-w-full my-[0.5em]';
          pre.before(wrapper);
          wrapper.append(pre);

          const button = document.createElement('button');
          button.className = 'group/code-copy absolute z-2 top-2 right-2 grid size-8 p-0 place-items-center [border:1px_solid_color-mix(in_srgb,var(--border-strong)_58%,transparent)] rounded-lg bg-[color-mix(in_srgb,var(--surface-raised)_90%,transparent)] shadow-[0_3px_10px_rgb(30_27_41/6%)] text-[var(--muted-light)] cursor-pointer [transition:opacity_0.16s,color_0.16s,border-color_0.16s,background_0.16s,transform_0.16s] hover:border-[color-mix(in_srgb,var(--brand)_34%,var(--border))] hover:bg-[var(--surface-raised)] hover:text-[var(--brand-strong)] data-[copy-state=success]:border-[color-mix(in_srgb,var(--success)_40%,var(--border))] data-[copy-state=success]:text-[var(--success)] data-[copy-state=error]:border-[color-mix(in_srgb,var(--danger)_38%,var(--border))] data-[copy-state=error]:text-[var(--danger)] opacity-0 pointer-events-none [transform:translateY(-3px)] group-hover/code-block:opacity-100 group-hover/code-block:pointer-events-auto group-hover/code-block:transform-none group-focus-within/code-block:opacity-100 group-focus-within/code-block:pointer-events-auto group-focus-within/code-block:transform-none focus-visible:opacity-100 [@media(hover:none)]:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:transform-none';
          button.type = 'button';
          button.setAttribute('aria-label', copyLabels.idle);
          button.title = copyLabels.idle;
          button.innerHTML = `
            <svg class="size-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.8] block group-data-[copy-state=success]/code-copy:hidden" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="14" height="14" rx="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg class="size-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.8] hidden group-data-[copy-state=success]/code-copy:block" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          `;
          wrapper.append(button);

          setupCopy(button, () => code.textContent || '');
        });

      })();
    </script>
    {import.meta.env.PROD && Object.entries(config.analytics).map(([name, props]) => {
      if (!Object.hasOwn(Analytics, name)) {
        throw new Error(`Unknown analytics component "${name}". Use an export from astro-analytics.`);
      }
      const Component = Analytics[name as keyof typeof Analytics] as AstroComponentFactory;
      return <Component {...props} />;
    })}
  </body>
</html>
