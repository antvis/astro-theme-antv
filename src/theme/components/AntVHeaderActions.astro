---
import githubIcon from '../assets/icons/github.svg?raw';
import wechatIcon from '../assets/icons/wechat.svg?raw';

interface Props {
  locale: 'zh' | 'en';
  repository: string;
}

const { locale, repository } = Astro.props;
const isZh = locale === 'zh';
---

<div class="antv-header-actions">
  <details class="antv-community" data-antv-community>
    <summary aria-label={isZh ? '微信公众号' : 'WeChat'} title={isZh ? '微信扫一扫关注' : 'Scan QR Code to Follow'}>
      <span class="antv-header-icon" aria-hidden="true" set:html={wechatIcon}></span>
      <span class="action-label">{isZh ? '微信公众号' : 'WeChat'}</span>
    </summary>
    <div class="antv-community-popover">
      <div class="antv-community-card">
        <img
          src="https://gw.alipayobjects.com/zos/antfincdn/ZKlx96dsfs/qrcode_for_gh_f52d8b6aa591_258.jpg"
          width="128"
          height="128"
          alt={isZh ? 'AntV 微信公众号二维码' : 'AntV WeChat official account QR code'}
          decoding="async"
        />
        <p>{isZh ? '微信扫一扫关注' : 'Scan with WeChat to follow'}</p>
      </div>
    </div>
  </details>
  <a class="antv-github" href={repository} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
    <span class="antv-header-icon" aria-hidden="true" set:html={githubIcon}></span>
    <span class="action-label">GitHub</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-antv-community]').forEach((community) => {
    community.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && window.matchMedia('(hover: hover)').matches) community.open = true;
    });
    community.addEventListener('pointerleave', () => {
      if (!community.matches(':focus-within')) community.open = false;
    });
    community.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && community.contains(event.relatedTarget)) return;
      community.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') community.open = false;
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !community.contains(event.target)) community.open = false;
    });
  });
</script>

<style>
  .antv-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #697b8c;
  }
  .antv-community {
    position: relative;
  }
  .antv-community > summary,
  .antv-github {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 6px;
    color: inherit;
    cursor: pointer;
    list-style: none;
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  .antv-community > summary::-webkit-details-marker {
    display: none;
  }
  .antv-community > summary:hover,
  .antv-github:hover {
    color: var(--brand);
  }
  :global(.antv-site-header.home-header) .antv-header-actions {
    color: #424e66;
  }
  :global(.antv-site-header.home-header) .antv-community > summary:hover,
  :global(.antv-site-header.home-header) .antv-github:hover {
    color: #424e66;
    background: #fff;
    box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
  }
  .antv-header-icon {
    display: inline-flex;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }
  .antv-header-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .action-label {
    display: none;
  }
  .antv-community > summary:focus-visible,
  .antv-github:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
  .antv-community-popover {
    position: absolute;
    top: 100%;
    right: 0;
    width: 164px;
    padding-top: 12px;
  }
  .antv-community-card {
    padding: 12px 16px;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 3px 12px rgb(0 0 0 / 16%);
    text-align: center;
  }
  .antv-community-card img {
    display: block;
    width: 128px;
    height: 128px;
    padding: 2px;
    background: #fff;
  }
  .antv-community-card p {
    margin: 8px 0 0;
    color: #424e66;
    font-size: 12px;
    line-height: 20px;
    white-space: normal;
  }
  @media (max-width: 900px) {
    .antv-header-actions {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding: 0 24px;
      font-size: 16px;
    }
    .antv-community > summary,
    .antv-github {
      width: 100%;
      min-height: 58px;
      justify-content: flex-start;
      gap: 12px;
    }
    .action-label {
      display: inline;
    }
    .antv-community-popover {
      position: static;
      padding: 0 0 12px;
    }
  }
</style>
