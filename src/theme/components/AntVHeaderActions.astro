---
import githubIcon from '../assets/icons/github.svg?raw';
import wechatIcon from '../assets/icons/wechat.svg?raw';

interface Props {
  locale: 'zh' | 'en';
  repository: string;
}

const { locale, repository } = Astro.props;
const isZh = locale === 'zh';
const actionClass = [
  'inline-flex size-8 items-center justify-center p-0 rounded-md text-inherit cursor-pointer list-none no-underline [transition:color_0.2s,background_0.2s,box-shadow_0.2s] hover:text-[var(--brand)] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-[var(--brand)] focus-visible:outline-offset-4',
  '[.antv-site-header.home-header_&]:hover:text-[#424e66] [.antv-site-header.home-header_&]:hover:bg-white [.antv-site-header.home-header_&]:hover:shadow-[0_2px_5px_rgb(0_0_0/10%)]',
  '[@media(width<=900px)]:w-full [@media(width<=900px)]:min-h-[58px] [@media(width<=900px)]:justify-start [@media(width<=900px)]:gap-3',
].join(' ');
const iconClass = 'inline-flex size-5 [flex:0_0_20px] [&_svg]:size-full';
---

<div class="flex items-center gap-2 text-[var(--muted)] [.antv-site-header.home-header_&]:text-[#424e66] [@media(width<=900px)]:items-stretch [@media(width<=900px)]:flex-col [@media(width<=900px)]:gap-0 [@media(width<=900px)]:px-6 [@media(width<=900px)]:py-0 [@media(width<=900px)]:text-[16px]">
  <details class="relative [&>summary::-webkit-details-marker]:hidden" data-antv-community>
    <summary class={actionClass} aria-label={isZh ? '微信公众号' : 'WeChat'} title={isZh ? '微信扫一扫关注' : 'Scan QR Code to Follow'}>
      <span class={iconClass} aria-hidden="true" set:html={wechatIcon}></span>
      <span class="hidden [@media(width<=900px)]:inline">{isZh ? '微信公众号' : 'WeChat'}</span>
    </summary>
    <div class="absolute top-full right-0 w-[164px] pt-3 [@media(width<=900px)]:static [@media(width<=900px)]:pt-0 [@media(width<=900px)]:pb-3">
      <div class="py-3 px-4 rounded bg-white shadow-[0_3px_12px_rgb(0_0_0/16%)] text-center">
        <img
          class="block size-32 p-0.5 bg-white"
          src="https://gw.alipayobjects.com/zos/antfincdn/ZKlx96dsfs/qrcode_for_gh_f52d8b6aa591_258.jpg"
          width="128"
          height="128"
          alt={isZh ? 'AntV 微信公众号二维码' : 'AntV WeChat official account QR code'}
          decoding="async"
        />
        <p class="mt-2 mx-0 mb-0 text-[#424e66] text-[12px] leading-5 whitespace-normal">{isZh ? '微信扫一扫关注' : 'Scan with WeChat to follow'}</p>
      </div>
    </div>
  </details>
  <a class={actionClass} href={repository} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
    <span class={iconClass} aria-hidden="true" set:html={githubIcon}></span>
    <span class="hidden [@media(width<=900px)]:inline">GitHub</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-antv-community]').forEach((community) => {
    community.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && window.matchMedia('(hover: hover)').matches) community.open = true;
    });
    community.addEventListener('pointerleave', () => {
      if (!community.matches(':focus-within')) community.open = false;
    });
    community.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && community.contains(event.relatedTarget)) return;
      community.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') community.open = false;
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !community.contains(event.target)) community.open = false;
    });
  });
</script>
