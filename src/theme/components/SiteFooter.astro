---
import { localize } from '../../compiler/localization.js';
import type { LocalizedText, LocalizedLink } from '../../compiler/config.js';
import zhihuIcon from '../assets/icons/zhihu.svg?raw';
import githubIcon from '../assets/icons/github.svg?raw';
import wechatIcon from '../assets/icons/wechat.svg?raw';
import booksIcon from '@tabler/icons/outline/books.svg?raw';
import paletteIcon from '@tabler/icons/outline/palette.svg?raw';
import usersIcon from '@tabler/icons/outline/users.svg?raw';
import fileTextIcon from '@tabler/icons/outline/file-text.svg?raw';
import fileStackIcon from '@tabler/icons/outline/file-stack.svg?raw';

const icons = new Map([
  ['github', githubIcon],
  ['official_account', wechatIcon],
  ['books', booksIcon],
  ['palette', paletteIcon],
  ['users', usersIcon],
  ['zhihu', zhihuIcon],
  ['file-text', fileTextIcon],
  ['file-stack', fileStackIcon],
]);

interface FooterLink extends LocalizedLink {
  description?: LocalizedText;
  icon?: string;
  target?: string;
}
interface Props {
  locale: 'zh' | 'en';
  groups: { title: LocalizedText; icon?: string; links: FooterLink[] }[];
  description: string;
  copyright: string;
  tagline: string;
}
const { locale, groups, description, copyright, tagline } = Astro.props;
const footerClass = 'w-[min(1440px,calc(100%_-_80px))] mx-auto my-0 text-black/85 text-[14px] [@media(width<=767px)]:w-[calc(100%_-_32px)]';
const linkClass = 'text-inherit text-[14px] font-normal no-underline [transition:color_0.2s] [overflow-wrap:anywhere] hover:text-[var(--brand)] focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-[var(--brand)] focus-visible:outline-offset-4';
const iconClass = 'inline-block size-4 mr-[0.4em] align-[-2px] object-contain [&_svg]:block [&_svg]:size-full';
const headingIconClass = 'inline-flex shrink-0 size-[22px] object-contain [&_svg]:block [&_svg]:size-full [&_svg]:[stroke-width:1.5]';
const isImageLink = (href: string) => /\.(?:avif|bmp|gif|ico|jpe?g|png|svg|webp)$/i.test(href.split(/[?#]/, 1)[0]);
---

<footer class:list={[footerClass, "leading-[1.5] pt-20 pb-5 px-0 [@media(width<=767px)]:py-10"]} data-pagefind-ignore>
  <div class="flex justify-around gap-8 flex-wrap [@media(width<=767px)]:block [@media(width<=767px)]:text-center">
    {groups.map((group) => (
      <section class="min-w-0 mb-15 [@media(768px<=width<=1100px)]:basis-[calc(50%_-_32px)] [@media(width<=767px)]:mb-10 [@media(width<=767px)]:last:mb-0">
        <h2 class="flex items-center gap-2 m-0 text-[16px] font-bold leading-6 [@media(width<=767px)]:justify-center">
          {group.icon && (icons.has(group.icon)
            ? <span class={headingIconClass} aria-hidden="true" set:html={icons.get(group.icon)} />
            : <img class={headingIconClass} src={group.icon} width="22" height="22" alt="" loading="lazy" />)}
          {localize(group.title, locale)}
        </h2>
        <ul class="m-0 p-0 list-none">
          {group.links.map((link) => (
            <li class="my-3 mx-0">
              <a class:list={[linkClass, { 'group/footer-image relative inline-block': isImageLink(link.href) }]} href={link.href} target={link.target ?? (/^https?:\/\//.test(link.href) ? '_blank' : undefined)} rel={link.target === '_blank' || /^https?:\/\//.test(link.href) ? 'noopener noreferrer' : undefined}>
                {link.icon && (icons.has(link.icon)
                  ? <span class:list={[iconClass, link.icon === 'zhihu' && 'text-[#0084ff] font-semibold leading-4']} aria-hidden="true" set:html={icons.get(link.icon)} />
                  : <img class={iconClass} src={link.icon} width="16" height="16" alt="" loading="lazy" />)}
                <span>{localize(link.text, locale)}</span>
                {link.description && <span class="ml-[0.5em] opacity-60 font-normal">{localize(link.description, locale)}</span>}
                {isImageLink(link.href) && (
                  <span class="invisible absolute bottom-full left-1/2 z-20 w-[164px] -translate-x-1/2 pb-3 group-hover/footer-image:visible group-focus-visible/footer-image:visible" aria-hidden="true">
                    <span class="block rounded bg-white p-4 shadow-[0_3px_12px_rgb(0_0_0/16%)]">
                      <img class="block h-auto max-h-48 w-full object-contain" src={link.href} alt="" loading="lazy" decoding="async" />
                    </span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  {description && <p class="mt-0 mx-0 mb-5 text-center text-[var(--muted)] [@media(width<=767px)]:mt-8 [@media(width<=767px)]:mb-0">{description}</p>}
</footer>
<div class:list={[footerClass, "flex flex-wrap justify-center gap-x-6 gap-y-0 py-4 px-0 border-t border-t-[#e8e8e8] leading-8 text-center [@media(width<=767px)]:flex-col"]} data-pagefind-ignore>
  <span>{copyright}</span>
  {tagline && <span>{tagline}</span>}
</div>
