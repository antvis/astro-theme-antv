---
import ExampleCategoryIcon from './ExampleCategoryIcon.astro';

export interface SidebarMenuNode {
  key: string;
  label: string;
  href?: string;
  icon?: string;
  thumbnail?: string;
  current?: boolean;
  open?: boolean;
  children?: SidebarMenuNode[];
}

interface Props {
  nodes: SidebarMenuNode[];
  variant?: 'docs' | 'examples';
  depth?: number;
  indent?: number;
}

const {
  nodes,
  variant = 'docs',
  depth = 0,
  indent = variant === 'examples' ? 24 : 16,
} = Astro.props;
const offset = 24 + depth * indent;
const containsCurrent = (node: SidebarMenuNode): boolean =>
  Boolean(node.current || node.children?.some(containsCurrent));
---

<ul class:list={['sidebar-menu', `sidebar-menu--${variant}`]}>
  {nodes.map((node) => {
    const children = node.children || [];
    const hasChildren = children.length > 0;
    const isOpen = node.open ?? containsCurrent(node);
    return (
      <li
        class="sidebar-menu__item"
        data-sidebar-key={node.key}
        style={`--sidebar-menu-offset: ${offset}px;`}
      >
        {hasChildren ? (
          <details class:list={["sidebar-menu__details", variant === 'examples' && "[interpolate-size:allow-keywords] [&::details-content]:h-0 [&[open]::details-content]:h-auto [&::details-content]:overflow-clip [&::details-content]:[transition:height_180ms_ease,content-visibility_180ms_allow-discrete] motion-reduce:[&::details-content]:transition-none"]} open={isOpen}>
            <summary
              class:list={[
                'sidebar-menu__summary',
                { 'is-current': node.current },
              ]}
            >
              <span class="sidebar-menu__label">
                {node.icon && <ExampleCategoryIcon icon={node.icon} />}
                {node.href ? (
                  <a
                    class="sidebar-menu__summary-link"
                    href={node.href}
                    aria-current={node.current ? 'page' : undefined}
                    title={node.label}
                  >
                    {node.label}
                  </a>
                ) : (
                  <span class="sidebar-menu__text" title={node.label}>
                    {node.label}
                  </span>
                )}
              </span>
              <span class:list={["sidebar-menu__chevron", variant === 'examples' && "[transform:rotate(45deg)]! [[open]>summary_&]:[transform:rotate(225deg)]!"]} aria-hidden="true" />
            </summary>
            <Astro.self
              nodes={children}
              variant={variant}
              depth={depth + 1}
              indent={indent}
            />
          </details>
        ) : node.href && node.thumbnail ? (
          <a
            class="group/thumb block py-1 pl-[var(--sidebar-menu-offset)] hover:bg-black/4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--brand)] aria-[current=page]:bg-black/5"
            href={node.href}
            aria-current={node.current ? 'page' : undefined}
            aria-label={node.label}
            aria-describedby="example-thumbnail-tooltip"
            data-demo-link
            data-demo-thumbnail
          >
            <span class="block h-17.5 w-25 border border-[var(--border-soft)] bg-white group-aria-[current=page]/thumb:border-[var(--brand)] group-aria-[current=page]/thumb:bg-[var(--brand-soft)]">
              <img src={node.thumbnail} alt="" loading="lazy" decoding="async" class="block size-full object-contain mix-blend-multiply" />
            </span>
          </a>
        ) : node.href ? (
          <a
            class="sidebar-menu__link"
            data-demo-link={variant === 'examples' && depth === 2 ? true : undefined}
            href={node.href}
            aria-current={node.current ? 'page' : undefined}
            title={node.label}
          >
            {node.icon && <ExampleCategoryIcon icon={node.icon} />}
            <span class="sidebar-menu__text">{node.label}</span>
          </a>
        ) : null}
      </li>
    );
  })}
</ul>
