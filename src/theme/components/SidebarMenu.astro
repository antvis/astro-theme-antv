---
import ExampleCategoryIcon from './ExampleCategoryIcon.astro';

export interface SidebarMenuNode {
  key: string;
  label: string;
  href?: string;
  icon?: string;
  thumbnail?: string;
  current?: boolean;
  open?: boolean;
  children?: SidebarMenuNode[];
}

interface Props {
  nodes: SidebarMenuNode[];
  variant?: 'docs' | 'examples';
  depth?: number;
  indent?: number;
}

const {
  nodes,
  variant = 'docs',
  depth = 0,
  indent = variant === 'examples' ? 24 : 16,
} = Astro.props;
const offset = 24 + depth * indent;
const containsCurrent = (node: SidebarMenuNode): boolean =>
  Boolean(node.current || node.children?.some(containsCurrent));
const menuItemClass = "relative box-border flex items-center w-full min-h-10 m-0 py-0 pr-4 pl-[var(--sidebar-menu-offset)] rounded-none text-[var(--text)] text-[14px] font-normal leading-10 no-underline [transition:background-color_0.2s,color_0.2s] hover:bg-black/2 hover:text-[var(--brand)] [&:is([data-current],[aria-current])]:bg-[var(--brand-soft)] [&:is([data-current],[aria-current])]:text-[var(--brand-strong)] [&:is([data-current],[aria-current])]:font-semibold [&:is([data-current],[aria-current])]:after:content-[''] [&:is([data-current],[aria-current])]:after:absolute [&:is([data-current],[aria-current])]:after:inset-y-0 [&:is([data-current],[aria-current])]:after:right-0 [&:is([data-current],[aria-current])]:after:w-[3px] [&:is([data-current],[aria-current])]:after:bg-[var(--brand)]";

---

<ul data-sidebar-menu class:list={["m-0 p-0 list-none", variant === "examples" && depth > 0 && "pb-2"]}>
  {nodes.map((node) => {
    const children = node.children || [];
    const hasChildren = children.length > 0;
    const isOpen = node.open ?? containsCurrent(node);
    return (
      <li
        class="m-0 list-none"
        data-sidebar-key={node.key}
        style={`--sidebar-menu-offset: ${offset}px;`}
      >
        {hasChildren ? (
          <details data-sidebar-details class:list={["border-0", variant === 'examples' && "[interpolate-size:allow-keywords] [&::details-content]:h-0 [&[open]::details-content]:h-auto [&::details-content]:overflow-clip [&::details-content]:[transition:height_180ms_ease,content-visibility_180ms_allow-discrete] motion-reduce:[&::details-content]:transition-none"]} open={isOpen}>
            <summary
              data-sidebar-summary data-current={node.current || undefined}
              class={`${menuItemClass} justify-between list-none cursor-pointer [&::-webkit-details-marker]:hidden marker:content-['']`}
            >
              <span class="flex flex-1 items-center min-w-0">
                {node.icon && <ExampleCategoryIcon icon={node.icon} />}
                {node.href ? (
                  <a
                    data-sidebar-category-link class="min-w-0 truncate text-inherit no-underline focus-visible:[outline:2px_solid_var(--brand)] focus-visible:outline-offset-[-2px]"
                    href={node.href}
                    aria-current={node.current ? 'page' : undefined}
                    title={node.label}
                  >
                    {node.label}
                  </a>
                ) : (
                  <span class="min-w-0 truncate text-inherit" title={node.label}>
                    {node.label}
                  </span>
                )}
              </span>
              <span class:list={["shrink-0 basis-[7px] size-[7px] ml-3 mr-[3px] [border-right:1px_solid_currentColor] [border-bottom:1px_solid_currentColor] opacity-55 [transition:transform_0.2s]", variant === 'examples' ? "[transform:rotate(45deg)] [[open]>summary_&]:[transform:rotate(225deg)]" : "[transform:rotate(-45deg)] [[open]>summary_&]:[transform:rotate(45deg)_translate(-1px,-1px)]"]} aria-hidden="true" />
            </summary>
            <Astro.self
              nodes={children}
              variant={variant}
              depth={depth + 1}
              indent={indent}
            />
          </details>
        ) : node.href && node.thumbnail ? (
          <a
            class="group/thumb block py-1 pl-[var(--sidebar-menu-offset)] hover:bg-black/4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--brand)] aria-[current=page]:bg-black/5"
            href={node.href}
            aria-current={node.current ? 'page' : undefined}
            aria-label={node.label}
            aria-describedby="example-thumbnail-tooltip"
            data-demo-link
            data-demo-thumbnail
          >
            <span class="block h-17.5 w-25 border border-[var(--border-soft)] bg-white group-aria-[current=page]/thumb:border-[var(--brand)] group-aria-[current=page]/thumb:bg-[var(--brand-soft)]">
              <img src={node.thumbnail} alt="" loading="lazy" decoding="async" class="block size-full object-contain mix-blend-multiply" />
            </span>
          </a>
        ) : node.href ? (
          <a
            class={`${menuItemClass} focus-visible:[outline:2px_solid_var(--brand)] focus-visible:outline-offset-[-2px]`}
            data-demo-link={variant === 'examples' && depth === 2 ? true : undefined}
            href={node.href}
            aria-current={node.current ? 'page' : undefined}
            title={node.label}
          >
            {node.icon && <ExampleCategoryIcon icon={node.icon} />}
            <span class="min-w-0 flex-1 truncate text-inherit">{node.label}</span>
          </a>
        ) : null}
      </li>
    );
  })}
</ul>
