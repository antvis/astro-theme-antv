---
import { localize } from '../../compiler/localization.js';
import type { ExampleCategory } from '../../compiler/content.js';
import { withBase } from '../lib/paths';
import SidebarMenu from './SidebarMenu.astro';
import searchIcon from '@tabler/icons/outline/search.svg?raw';
import collapseIcon from '@tabler/icons/outline/arrow-bar-to-up.svg?raw';

interface Props {
  categories: ExampleCategory[];
  locale: 'zh' | 'en';
  currentRoute: string;
}
const { categories, locale, currentRoute } = Astro.props;
const catalogRoute = `/${locale}/examples/`;
const isCatalog = currentRoute === catalogRoute;
const groupAnchor = (categorySlug: string, groupSlug: string) =>
  `group-${categorySlug}-${groupSlug.replaceAll('/', '-')}`;
const categoryDemoCount = (category: ExampleCategory) =>
  category.groups.reduce(
    (sum, group) => sum + group.demos.length,
    0,
  );
const navigationCategories = isCatalog
  ? categories.filter((category) => categoryDemoCount(category) > 0)
  : categories;
const nodes = navigationCategories.map((category) => ({
  key: category.slug,
  label: localize(category.title, locale),
  href: isCatalog
    ? `#category-${category.slug}`
    : undefined,
  icon: category.icon,
  open: !isCatalog && currentRoute.includes(`/examples/${category.slug}/`),
  children: category.groups.map((group) => {
    const route = `/${locale}/examples/${category.slug}/${group.slug}/`;
    const groupIsCurrent =
      !isCatalog &&
      (route === currentRoute || currentRoute.startsWith(route));
    return {
      key: `${category.slug}/${group.slug}`,
      label: localize(group.title, locale),
      href: isCatalog
        ? `#${groupAnchor(category.slug, group.slug)}`
        : undefined,
      open: groupIsCurrent,
      children:
        !isCatalog
          ? group.demos.map((demo) => {
              const demoRoute = `/${locale}/examples/${demo.key}/`;
              return {
                key: demo.key,
                label: localize(demo.title, locale, demo.slug),
                href: withBase(demoRoute),
                thumbnail: demo.screenshot ? withBase(demo.screenshot) : undefined,
                current: demoRoute === currentRoute,
                children: [],
              };
            })
          : [],
    };
  }),
}));
---

<aside
  class:list={["sticky top-[var(--header-height)] self-start max-h-[calc(100dvh_-_var(--header-height))] overflow-x-hidden overflow-y-auto pb-12 [border-right:1px_solid_var(--border-soft)] bg-[var(--surface-raised)] [@media(width<=900px)]:static [@media(width<=900px)]:max-h-85 [@media(width<=900px)]:mt-6 [@media(width<=900px)]:mb-8 [@media(width<=900px)]:p-4 [@media(width<=900px)]:overflow-auto [@media(width<=900px)]:[border:1px_solid_var(--border)] [@media(width<=900px)]:rounded-[var(--radius-medium)] [@media(width<=900px)]:bg-[var(--surface-subtle)] pt-6", !isCatalog && "z-10 [@media(width>1080px)]:h-full [@media(width>1080px)]:max-h-full"]}
  data-example-sidebar
  data-example-catalog={isCatalog ? 'true' : undefined}
>
  {!isCatalog && <div data-example-controls hidden class="sticky top-0 z-1 flex items-center gap-2 bg-white px-4 pb-3 [&[hidden]]:hidden">
    <label class="flex min-w-0 flex-1 items-center gap-1.5 rounded border border-[var(--border)] px-2 text-[var(--muted-light)] focus-within:border-[var(--brand)]">
      <span aria-hidden="true" class="inline-flex size-3.5 shrink-0 [&_svg]:size-full" set:html={searchIcon} />
      <input data-example-search type="search" placeholder={locale === 'zh' ? '搜索…' : 'Search…'} aria-label={locale === 'zh' ? '搜索示例' : 'Search examples'} class="h-7 w-full min-w-0 border-0 bg-transparent p-0 text-xs text-[var(--text)] outline-none" />
    </label>
    <button data-example-collapse type="button" title={locale === 'zh' ? '全部收起' : 'Collapse all'} aria-label={locale === 'zh' ? '全部收起' : 'Collapse all'} class="inline-flex size-7 shrink-0 cursor-pointer items-center justify-center border-0 bg-transparent p-1 text-[var(--text)] hover:text-[var(--brand)] [&_svg]:size-4" set:html={collapseIcon} />
  </div>}
  <p data-example-empty hidden class="m-0 px-4 py-3 text-xs text-[var(--muted)] [&[hidden]]:hidden" role="status">{locale === 'zh' ? '没有匹配的示例' : 'No matching examples'}</p>
  <nav aria-label={locale === 'zh' ? '示例目录' : 'Examples'}>
    <SidebarMenu nodes={nodes} variant="examples" />
  </nav>
  {!isCatalog && <div id="example-thumbnail-tooltip" role="tooltip" hidden class="pointer-events-none fixed z-300 max-w-64 -translate-y-1/2 rounded-lg bg-[#262626] px-3 py-2 text-sm text-white shadow-xl [&[hidden]]:hidden before:absolute before:top-1/2 before:-left-1 before:size-2 before:-translate-y-1/2 before:rotate-45 before:bg-[#262626]"></div>}
</aside>

<script>
  const sidebars = document.querySelectorAll<HTMLElement>(
    '[data-example-sidebar]',
  );

  for (const sidebar of sidebars) {
    const controls = sidebar.querySelector<HTMLElement>('[data-example-controls]');
    if (controls) {
      controls.hidden = false;
      const search = controls.querySelector<HTMLInputElement>('input')!;
      const empty = sidebar.querySelector<HTMLElement>('[data-example-empty]')!;
      const details = [...sidebar.querySelectorAll<HTMLDetailsElement>('details')];
      const examples = [...sidebar.querySelectorAll<HTMLAnchorElement>('[data-demo-link]')].map((link) => {
        const labels = [link.getAttribute('aria-label') ?? link.textContent, link.getAttribute('href')];
        for (let branch = link.closest('details'); branch; branch = branch.parentElement!.closest('details')) {
          labels.push(branch.querySelector('summary')!.textContent);
        }
        return { item: link.parentElement!, label: labels.join(' ').toLocaleLowerCase() };
      });
      let savedOpen: boolean[] | undefined;
      const filter = () => {
        const query = search.value.trim().toLocaleLowerCase();
        if (query && !savedOpen) savedOpen = details.map((item) => item.open);
        examples.forEach(({ item, label }) => { item.hidden = !label.includes(query); });
        for (const branch of [...details].reverse()) {
          branch.parentElement!.hidden = !branch.querySelector(':scope > ul > li:not([hidden])');
          if (query) branch.open = !branch.parentElement!.hidden;
        }
        empty.hidden = examples.some(({ item }) => !item.hidden);
        if (!query && savedOpen) {
          details.forEach((item, index) => { item.open = savedOpen![index]!; });
          savedOpen = undefined;
        }
      };
      search.addEventListener('input', filter);
      controls.querySelector('button')!.addEventListener('click', () => {
        search.value = '';
        filter();
        details.forEach((item) => { item.open = false; });
      });
      sidebar.addEventListener('antv:example-selected', (event) => {
        const link = (event as CustomEvent<HTMLAnchorElement>).detail;
        if (link.closest('[hidden]')) {
          search.value = '';
          filter();
        }
        for (let branch = link.closest('details'); branch; branch = branch.parentElement!.closest('details')) branch.open = true;
        ensureMenuItemVisible(link);
      });
    }
    const tooltip = sidebar.querySelector<HTMLElement>('[role="tooltip"]');
    if (tooltip) {
      const hide = () => { tooltip.hidden = true; };
      const show = (event: Event) => {
        const link = (event.target as Element).closest<HTMLElement>('[data-demo-thumbnail]');
        if (!link) return hide();
        const bounds = (link.querySelector('img') ?? link).getBoundingClientRect();
        tooltip.textContent = link.getAttribute('aria-label');
        tooltip.hidden = false;
        tooltip.style.left = `${Math.min(bounds.right + 12, innerWidth - tooltip.offsetWidth - 8)}px`;
        tooltip.style.top = `${Math.max(tooltip.offsetHeight / 2 + 8, Math.min(bounds.top + bounds.height / 2, innerHeight - tooltip.offsetHeight / 2 - 8))}px`;
      };
      sidebar.addEventListener('pointerover', show);
      sidebar.addEventListener('focusin', show);
      sidebar.addEventListener('pointerleave', hide);
      sidebar.addEventListener('focusout', hide);
      window.addEventListener('scroll', hide, { capture: true, passive: true });
      window.addEventListener('resize', hide);
      sidebar.addEventListener('keydown', (event) => { if (event.key === 'Escape') hide(); });
    }

    const ensureMenuItemVisible = (element: HTMLElement | null) => {
      if (!element || sidebar.scrollHeight <= sidebar.clientHeight) return;
      const sidebarBounds = sidebar.getBoundingClientRect();
      const elementBounds = element.getBoundingClientRect();
      const padding = 16;

      if (elementBounds.top < sidebarBounds.top + padding) {
        sidebar.scrollTop += elementBounds.top - sidebarBounds.top - padding;
      } else if (elementBounds.bottom > sidebarBounds.bottom - padding) {
        sidebar.scrollTop +=
          elementBounds.bottom - sidebarBounds.bottom + padding;
      }
    };

    if (sidebar.dataset.exampleCatalog !== 'true') {
      requestAnimationFrame(() => {
        ensureMenuItemVisible(
          sidebar.querySelector<HTMLElement>('[aria-current="page"]'),
        );
      });
      continue;
    }

    const rootMenu = sidebar.querySelector<HTMLElement>(
      'nav > [data-sidebar-menu]',
    );
    const categoryItems = rootMenu
      ? [...rootMenu.children].filter(
          (item): item is HTMLElement => item instanceof HTMLElement,
        )
      : [];
    const categorySections = [
      ...document.querySelectorAll<HTMLElement>('[data-example-category]'),
    ];
    let selection = '';

    const setSelection = (
      categorySlug?: string,
      groupHash?: string,
      reveal = false,
    ) => {
      const nextSelection = `${categorySlug || 'all'}:${groupHash || ''}`;
      if (nextSelection === selection) return;
      selection = nextSelection;

      let activeElement: HTMLElement | null = null;
      categoryItems.forEach((item) => {
        const selected = item.dataset.sidebarKey === categorySlug;
        const details = item.querySelector<HTMLDetailsElement>(
          ':scope > [data-sidebar-details]',
        );
        const summary = details?.querySelector<HTMLElement>(
          ':scope > [data-sidebar-summary]',
        );
        const categoryLink = summary?.querySelector<HTMLAnchorElement>(
          '[data-sidebar-category-link]',
        );
        const groupLinks = [
          ...item.querySelectorAll<HTMLAnchorElement>('a[href^="#group-"]'),
        ];

        summary?.toggleAttribute('data-current', selected);
        if (categoryLink) {
          if (selected) categoryLink.setAttribute('aria-current', 'location');
          else categoryLink.removeAttribute('aria-current');
        }

        groupLinks.forEach((link) => {
          const groupSelected = selected && link.hash === groupHash;
          if (groupSelected) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
          if (groupSelected && details?.open) activeElement = link;
        });

        if (selected && !activeElement) {
          activeElement = categoryLink || summary || null;
        }
      });

      if (reveal) ensureMenuItemVisible(activeElement);
    };

    const targetFromHash = () => {
      if (!location.hash) return null;
      try {
        return document.getElementById(decodeURIComponent(location.hash.slice(1)));
      } catch {
        return null;
      }
    };

    const syncFromHash = () => {
      const target = targetFromHash();
      const category = target?.closest<HTMLElement>('[data-example-category]');
      if (!category?.dataset.exampleCategory) {
        setSelection(undefined, undefined, true);
        return;
      }
      const group = target?.closest<HTMLElement>('[data-example-group]');
      setSelection(
        category.dataset.exampleCategory,
        group ? `#${group.id}` : undefined,
        true,
      );
    };

    const syncFromScroll = () => {
      if (!categorySections.length) return;
      const headerHeight = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(
          '--header-height',
        ),
      );
      const offset = (Number.isFinite(headerHeight) ? headerHeight : 64) + 32;
      let activeCategory: HTMLElement | undefined;

      for (const category of categorySections) {
        if (category.getBoundingClientRect().top <= offset) {
          activeCategory = category;
        } else {
          break;
        }
      }

      if (!activeCategory?.dataset.exampleCategory) {
        setSelection(undefined);
        return;
      }

      let activeGroup: HTMLElement | undefined;
      const groups = [
        ...activeCategory.querySelectorAll<HTMLElement>('[data-example-group]'),
      ];
      for (const group of groups) {
        if (group.getBoundingClientRect().top <= offset) activeGroup = group;
        else break;
      }
      setSelection(
        activeCategory.dataset.exampleCategory,
        activeGroup ? `#${activeGroup.id}` : undefined,
        true,
      );
    };

    let scrollFrame = 0;
    const scheduleScrollSync = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        syncFromScroll();
      });
    };

    if (location.hash) syncFromHash();
    else {
      setSelection();
      requestAnimationFrame(syncFromScroll);
    }
    addEventListener('hashchange', syncFromHash);
    addEventListener('scroll', scheduleScrollSync, { passive: true });
    addEventListener('resize', scheduleScrollSync);
  }
</script>
