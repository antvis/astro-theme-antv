---
import Loading from './Loading.astro';
import { withBase } from '../lib/paths';

interface Props {
  locale: 'zh' | 'en';
  service: string;
  route: string;
}

const { locale, service, route } = Astro.props;
const sdkUrl = new URL('/sdk/qa/sive-qa.js', service).toString();
const loadError = locale === 'zh'
  ? '问答模块加载失败，请刷新页面重试。'
  : 'Unable to load the QA module. Please refresh and try again.';
---

<section
  class="antv-qa-page"
  aria-label={locale === 'zh' ? 'AI 问答' : 'Conversation'}
>
  <div
    id="sive-qa-root"
    class="antv-qa-root"
    data-qa-path={withBase(route)}
  >
    <div class="antv-qa-loading"><Loading locale={locale} /></div>
  </div>
  <p class="antv-qa-error" data-qa-sdk-error hidden>{loadError}</p>
</section>
<script is:inline type="module" src={sdkUrl}></script>
<script is:inline type="module">
  try {
    const root = document.querySelector('#sive-qa-root');
    window.SiveQA.mount('#sive-qa-root', {
      qaPath: root.dataset.qaPath,
    });
  } catch {
    document.querySelector('[data-qa-sdk-error]').hidden = false;
  }
</script>

<style>
  /* The SDK root is outside theme utilities; keep its sizing at this boundary. */
  .antv-qa-page,
  .antv-qa-root {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .antv-qa-page {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .antv-qa-loading { display: grid; height: 100%; place-items: center; }

  .antv-qa-page:has(> .antv-qa-error:not([hidden])) .antv-qa-loading {
    display: none;
  }

  .antv-qa-error {
    position: absolute;
    inset: 0;
    display: grid;
    margin: 0;
    padding: 24px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    place-items: center;
  }

  .antv-qa-error[hidden] {
    display: none;
  }
</style>
