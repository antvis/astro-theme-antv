---
import arrowUpIcon from '@tabler/icons/outline/arrow-up.svg?raw';
import { withBase } from '../lib/paths';
import { config } from '../lib/site';

interface Props {
  locale: 'zh' | 'en';
}

const { locale } = Astro.props;
const qa = config.qa;
const isZh = locale === 'zh';
const prompt = isZh ? '今天，你想可视化什么？' : 'What would you like to visualize today?';
const action = isZh ? '开始创作' : 'Create with AI';
const resultUrl = qa ? withBase(`/${locale}/${qa.path}/`.replace(/\/+/g, '/')) : '';
---

{qa && (
  <form class="antv-qa-entry" role="search" data-antv-qa-entry data-result-url={resultUrl}>
    <label class="antv-qa-visually-hidden" for={`antv-qa-query-${locale}`}>{prompt}</label>
    <textarea
      id={`antv-qa-query-${locale}`}
      class="antv-qa-prompt"
      rows="2"
      maxlength="4000"
      placeholder={prompt}
      autocomplete="off"
      data-qa-prompt
    ></textarea>
    <div class="antv-qa-meta">
      <span>{isZh ? 'AntV 智能可视化助手' : 'AntV visualization assistant'}</span>
      <button class="antv-qa-action" type="submit" aria-label={action} disabled>
        <span aria-hidden="true" set:html={arrowUpIcon}></span>
      </button>
    </div>
  </form>
)}

<script>
  import { mountQaEntries } from '../features/qa/entry';

  mountQaEntries();
</script>

<style>
  .antv-qa-entry {
    display: flex;
    width: min(750px, 100%);
    min-height: 168px;
    flex-direction: column;
    justify-content: space-between;
    margin-top: 26px;
    padding: 24px 24px 18px;
    border: 1px solid rgb(111 55 215 / 12%);
    border-radius: 16px;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 20px 56px rgb(77 37 143 / 13%);
    color: #211b2b;
    cursor: text;
    text-align: left;
    backdrop-filter: blur(16px);
    transition: border-color .25s, box-shadow .25s, transform .25s;
  }

  .antv-qa-entry:hover {
    border-color: rgb(105 30 255 / 32%);
    box-shadow: 0 22px 56px rgb(77 37 143 / 20%);
    transform: translateY(-3px);
  }

  .antv-qa-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .antv-qa-prompt {
    width: 100%;
    min-height: 56px;
    flex: 1 1 auto;
    padding: 0;
    border: 0;
    outline: 0;
    appearance: none;
    background: transparent;
    color: #211b2b;
    cursor: text;
    font: inherit;
    font-size: 15px;
    line-height: 1.6;
    resize: none;
  }

  .antv-qa-prompt::placeholder {
    color: #736d7d;
    opacity: 1;
  }

  .antv-qa-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: #837b8c;
    font-size: 12px;
  }

  .antv-qa-action {
    display: grid;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--brand);
    color: #fff;
    cursor: pointer;
    place-items: center;
    transition: opacity .2s, transform .2s;
  }

  .antv-qa-action:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .antv-qa-action:disabled {
    cursor: not-allowed;
    opacity: .4;
  }

  .antv-qa-action :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  @media (max-width: 640px) {
    .antv-qa-entry {
      min-height: 150px;
      padding: 20px;
    }
  }
</style>
