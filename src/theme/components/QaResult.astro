---
import Loading from './Loading.astro';

interface Props {
  locale: 'zh' | 'en';
  service: string;
}

const { locale, service } = Astro.props;
const sdkUrl = new URL('/sdk/qa/sive-qa.js', service).toString();
const loadError = locale === 'zh'
  ? '问答模块加载失败，请刷新页面重试。'
  : 'Unable to load the QA module. Please refresh and try again.';
---

<section
  class="antv-result-page"
  aria-label={locale === 'zh' ? '问答结果' : 'Conversation'}
>
  <div id="sive-qa-root" class="antv-result-root">
    <div class="antv-result-loading"><Loading locale={locale} /></div>
  </div>
  <p class="antv-result-error" data-qa-sdk-error hidden>{loadError}</p>
</section>
<script is:inline type="module" src={sdkUrl}></script>
<script is:inline type="module">
  try {
    window.SiveQA.mount('#sive-qa-root');
  } catch {
    document.querySelector('[data-qa-sdk-error]').hidden = false;
  }
</script>

<style>
  :global(body.page-qa) {
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
  }

  :global(body.page-qa .site-footer),
  :global(body.page-qa .footer-meta) {
    display: none;
  }

  :global(body.page-qa #main-content) {
    height: calc(100dvh - var(--header-height));
    min-height: 0;
    overflow: hidden;
  }

  .antv-result-page,
  .antv-result-root {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .antv-result-page {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .antv-result-loading { display: grid; height: 100%; place-items: center; }

  .antv-result-page:has(> .antv-result-error:not([hidden])) .antv-result-loading {
    display: none;
  }

  .antv-result-error {
    position: absolute;
    inset: 0;
    display: grid;
    margin: 0;
    padding: 24px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    place-items: center;
  }

  .antv-result-error[hidden] {
    display: none;
  }
</style>
