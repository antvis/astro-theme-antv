---
import arrowLeftIcon from '@tabler/icons/outline/arrow-left.svg?raw';
import sendIcon from '@tabler/icons/outline/send.svg?raw';
import { withBase } from '../lib/paths';

interface Props {
  locale: 'zh' | 'en';
  service: {
    development: string;
    production: string;
  };
}

const { locale, service } = Astro.props;
const isZh = locale === 'zh';
const qaServiceBaseUrl = import.meta.env.DEV
  ? service.development
  : service.production;
const text = {
  title: isZh ? '问答结果' : 'Conversation',
  loading: isZh ? '正在准备回答' : 'Preparing the answer',
  streaming: isZh ? '正在生成' : 'Generating',
  finished: isZh ? '回答完成' : 'Answer complete',
  aborted: isZh ? '回答已停止' : 'Answer stopped',
  errorStatus: isZh ? '生成失败，可以继续提问' : 'Generation failed. You can ask again.',
  errorTitle: isZh ? '无法载入本次问答' : 'Unable to load this conversation',
  missingDescription: isZh
    ? '结果地址缺少有效的会话信息，请返回首页重新提交。'
    : 'The result URL does not contain a valid session. Please submit again.',
  loadErrorDescription: isZh
    ? '结果暂时无法读取，请稍后重试。'
    : 'The result is temporarily unavailable. Please try again later.',
  emptyDescription: isZh
    ? '本次回答没有可展示的文本内容。'
    : 'This answer has no displayable text.',
  retrying: isZh ? '连接中断，正在重试' : 'Connection interrupted. Retrying.',
  back: isZh ? '返回首页' : 'Back to home',
  historyTitle: isZh ? '对话历史' : 'Conversation history',
  historyEmpty: isZh ? '暂无本地对话' : 'No local conversations yet',
  historyExpand: isZh ? '展开' : 'Show',
  historyCollapse: isZh ? '收起' : 'Hide',
  userRole: isZh ? '你' : 'You',
  assistantRole: isZh ? 'AntV AI' : 'AntV AI',
  followupLabel: isZh ? '继续提问' : 'Ask a follow-up',
  followupPlaceholder: isZh
    ? '继续追问配置、用法或实现细节'
    : 'Ask about configuration, usage, or implementation details',
  send: isZh ? '发送' : 'Send',
  submitting: isZh ? '正在检查登录状态' : 'Checking sign-in status',
  followupError: isZh ? '暂时无法发送，请重试。' : 'Unable to send. Please try again.',
  notice: isZh ? '内容由 AI 生成，请仔细甄别。' : 'AI-generated content may contain errors.',
  popupBlocked: isZh
    ? '浏览器阻止了登录窗口，请允许弹窗后重试。'
    : 'The sign-in window was blocked. Allow pop-ups and try again.',
  popupClosed: isZh
    ? '登录窗口已关闭，请重试。'
    : 'The sign-in window was closed. Please try again.',
  popupTimeout: isZh
    ? '登录等待超时，请重试。'
    : 'Sign-in timed out. Please try again.',
  previewTitle: isZh ? '可视化预览' : 'Visualization preview',
  previewView: isZh ? '查看效果' : 'View result',
  previewLoading: isZh ? '渲染中' : 'Rendering',
  previewRerender: isZh ? '重新渲染' : 'Render again',
  previewError: isZh
    ? '预览配置无效或渲染失败，页面不会执行其中的代码。'
    : 'The preview configuration is invalid or could not be rendered. No code was executed.',
  codeCopy: isZh ? '复制代码' : 'Copy code',
  codeCopied: isZh ? '已复制' : 'Copied',
  codeCopyError: isZh ? '复制失败' : 'Copy failed',
};
---

<section
  class="antv-result-page"
  aria-label={text.title}
  data-antv-result
  data-qa-service-base={qaServiceBaseUrl}
  data-text-aborted={text.aborted}
  data-text-assistant-role={text.assistantRole}
  data-text-code-copied={text.codeCopied}
  data-text-code-copy={text.codeCopy}
  data-text-code-copy-error={text.codeCopyError}
  data-text-empty={text.emptyDescription}
  data-text-error-status={text.errorStatus}
  data-text-finished={text.finished}
  data-text-followup-error={text.followupError}
  data-text-history-collapse={text.historyCollapse}
  data-text-history-empty={text.historyEmpty}
  data-text-history-expand={text.historyExpand}
  data-text-load-error={text.loadErrorDescription}
  data-text-loading={text.loading}
  data-text-missing={text.missingDescription}
  data-text-popup-blocked={text.popupBlocked}
  data-text-popup-closed={text.popupClosed}
  data-text-popup-timeout={text.popupTimeout}
  data-text-preview-error={text.previewError}
  data-text-preview-loading={text.previewLoading}
  data-text-preview-rerender={text.previewRerender}
  data-text-preview-title={text.previewTitle}
  data-text-preview-view={text.previewView}
  data-text-retrying={text.retrying}
  data-text-streaming={text.streaming}
  data-text-submitting={text.submitting}
  data-text-user-role={text.userRole}
  data-pagefind-ignore
>
  <div class="antv-result-inner">
    <aside class="antv-history" data-history data-open="false">
      <div class="antv-history-header">
        <h2>{text.historyTitle}</h2>
        <button
          type="button"
          aria-controls={`antv-history-list-${locale}`}
          aria-expanded="false"
          data-history-toggle
        >
          {text.historyExpand}
        </button>
      </div>
      <nav
        id={`antv-history-list-${locale}`}
        class="antv-history-list"
        aria-label={text.historyTitle}
        data-history-list
      >
        <p class="antv-history-empty">{text.historyEmpty}</p>
      </nav>
    </aside>

    <main class="antv-conversation-shell">
      <p class="antv-result-status" data-result-status role="status" aria-live="polite">
        {text.loading}
      </p>

      <div class="antv-conversation" data-result-messages aria-live="polite">
        <div class="antv-result-loading" data-result-loading>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="antv-result-error" data-result-error hidden>
        <h2>{text.errorTitle}</h2>
        <p data-result-error-description>{text.missingDescription}</p>
        <a class="antv-result-back" href={withBase(`/${locale}/`)}>
          <span aria-hidden="true" set:html={arrowLeftIcon}></span>
          {text.back}
        </a>
      </div>

      <form class="antv-followup" data-result-composer>
        <label for={`antv-followup-${locale}`}>{text.followupLabel}</label>
        <div class="antv-followup-control">
          <textarea
            id={`antv-followup-${locale}`}
            rows="1"
            maxlength="4000"
            placeholder={text.followupPlaceholder}
            data-followup-input
          ></textarea>
          <button type="submit" data-followup-submit aria-label={text.send} disabled>
            <span aria-hidden="true" set:html={sendIcon}></span>
          </button>
        </div>
        <p class="antv-followup-error" data-followup-error hidden></p>
      </form>

      <p class="antv-result-notice">{text.notice}</p>
    </main>
  </div>
</section>

<script>
  import { mountQaResult } from '../features/qa/result';

  mountQaResult();
</script>

<style>
  :global(body.page-qa) {
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
  }

  :global(body.page-qa .site-footer),
  :global(body.page-qa .footer-meta) {
    display: none;
  }

  :global(body.page-qa #main-content) {
    height: calc(100dvh - var(--header-height));
    min-height: 0;
    overflow: hidden;
  }

  .antv-result-page {
    height: 100%;
    min-height: 0;
    padding: 0 28px max(12px, env(safe-area-inset-bottom));
    overflow: hidden;
    background: var(--surface);
  }

  .antv-result-inner {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: 20px;
    margin: 0 auto;
  }

  .antv-history {
    display: grid;
    min-height: 0;
    grid-template-rows: auto minmax(0, 1fr);
    margin: 24px 0;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    background: var(--surface-raised);
  }

  .antv-history-header {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border-soft);
  }

  .antv-history-header h2 {
    margin: 0;
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 650;
  }

  .antv-history-header button {
    display: none;
    padding: 5px 8px;
    border: 0;
    border-radius: 7px;
    background: color-mix(in srgb, var(--brand) 8%, var(--surface));
    color: var(--brand-strong);
    cursor: pointer;
    font-size: 12px;
    font-weight: 650;
  }

  .antv-history-list {
    display: grid;
    min-height: 0;
    align-content: start;
    gap: 4px;
    padding: 8px;
    overflow-x: hidden;
    overflow-y: auto;
  }

  :global(.antv-history-item) {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px;
    padding: 8px 9px;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--text);
    transition: background .2s, border-color .2s, color .2s;
  }

  :global(.antv-history-item:hover) {
    border-color: var(--border-soft);
    background: var(--surface);
    color: var(--text-strong);
  }

  :global(.antv-history-item[aria-current='page']) {
    border-color: color-mix(in srgb, var(--brand) 32%, var(--border));
    background: color-mix(in srgb, var(--brand) 12%, var(--surface));
    box-shadow: inset 3px 0 0 var(--brand);
    color: var(--brand-strong);
  }

  :global(.antv-history-item-title) {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.45;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.antv-history-item-date) {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.9;
    opacity: 0;
    pointer-events: none;
    transition: opacity .16s;
    white-space: nowrap;
  }

  :global(.antv-history-item:hover .antv-history-item-date),
  :global(.antv-history-item:focus-visible .antv-history-item-date) {
    opacity: 1;
  }

  :global(.antv-history-empty) {
    margin: 0;
    padding: 16px 10px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .antv-result-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .antv-result-back {
    display: inline-flex;
    min-height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 15px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface-raised);
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    transition: border-color .2s, transform .2s;
  }

  .antv-result-back:hover {
    border-color: color-mix(in srgb, var(--brand) 34%, var(--border-strong));
    transform: translateY(-1px);
  }

  .antv-result-back:active {
    transform: scale(.98);
  }

  .antv-result-back:focus-visible,
  .antv-followup textarea:focus-visible,
  .antv-followup button:focus-visible,
  :global(.antv-code-copy:focus-visible),
  :global(.antv-code-preview button:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--brand) 38%, transparent);
    outline-offset: 3px;
  }

  .antv-result-back :global(svg) {
    width: 17px;
    height: 17px;
    stroke-width: 1.8;
  }

  .antv-conversation-shell {
    position: relative;
    display: grid;
    height: 100%;
    min-height: 0;
    min-width: 0;
    grid-template-rows: minmax(0, 1fr) auto auto;
  }

  .antv-conversation {
    display: grid;
    min-height: 0;
    min-width: 0;
    grid-row: 1;
    grid-auto-rows: max-content;
    align-content: start;
    gap: 34px;
    margin: 24px 0;
    padding: 16px 18px;
    overflow-x: hidden;
    overflow-y: auto;
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    clip-path: inset(0 round 18px);
    background: var(--surface-raised);
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  .antv-result-loading {
    display: grid;
    width: min(620px, 82%);
    gap: 12px;
    padding-top: 28px;
  }

  .antv-result-loading span {
    height: 13px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--brand) 8%, var(--border));
    animation: antv-result-loading 1.1s ease-in-out infinite alternate;
  }

  .antv-result-loading span:nth-child(2) {
    width: 88%;
    animation-delay: .14s;
  }

  .antv-result-loading span:nth-child(3) {
    width: 64%;
    animation-delay: .28s;
  }

  .antv-result-loading[hidden],
  .antv-result-error[hidden],
  .antv-followup[hidden],
  .antv-followup-error[hidden] {
    display: none;
  }

  :global(.antv-chat-message) {
    display: grid;
    min-width: 0;
    gap: 10px;
    animation: antv-message-enter .28s cubic-bezier(.16, 1, .3, 1) both;
  }

  :global(.antv-chat-role) {
    color: var(--muted);
    font-size: 12px;
    font-weight: 650;
  }

  :global(.antv-chat-message-user) {
    justify-items: end;
  }

  :global(.antv-chat-message-user .antv-chat-body) {
    max-width: min(660px, 88%);
    min-width: 0;
    padding: 13px 17px;
    border-radius: 14px 14px 4px 14px;
    background: color-mix(in srgb, var(--brand) 9%, var(--surface-raised));
    color: var(--text-strong);
    font-size: 15px;
    line-height: 1.65;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  :global(.antv-chat-message-assistant .antv-chat-body) {
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text-strong);
    font-size: 16px;
    line-height: 1.82;
  }

  :global(.antv-chat-message-assistant.antv-chat-message-streaming .antv-chat-body)::after {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 4px;
    border-radius: 2px;
    background: var(--brand);
    content: '';
    vertical-align: -.15em;
    animation: antv-stream-caret .75s steps(1) infinite;
  }

  :global(.antv-chat-message-assistant.antv-chat-message-waiting .antv-chat-body) {
    color: var(--muted);
    font-size: 14px;
    animation: antv-waiting 1s ease-in-out infinite alternate;
  }

  :global(.antv-chat-message-error .antv-chat-body) {
    color: #b42318;
  }

  :global(.antv-chat-body :first-child) {
    margin-top: 0;
  }

  :global(.antv-chat-body :last-child) {
    margin-bottom: 0;
  }

  :global(.antv-chat-body h2),
  :global(.antv-chat-body h3) {
    margin: 1.7em 0 .65em;
    letter-spacing: -.02em;
    line-height: 1.35;
  }

  :global(.antv-chat-body p),
  :global(.antv-chat-body ul),
  :global(.antv-chat-body ol),
  :global(.antv-chat-body blockquote),
  :global(.antv-chat-body pre) {
    margin: 1em 0;
  }

  :global(.antv-chat-body ul),
  :global(.antv-chat-body ol) {
    padding-left: 1.5em;
  }

  :global(.antv-chat-body a) {
    color: var(--brand-strong);
    text-underline-offset: 3px;
  }

  :global(.antv-chat-body code) {
    padding: .15em .38em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--brand) 7%, var(--surface));
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .9em;
  }

  :global(.antv-chat-body pre) {
    --syntax-comment: #6e7781;
    --syntax-keyword: #cf222e;
    --syntax-number: #953800;
    --syntax-string: #116329;
    --syntax-title: #0550ae;
    --syntax-variable: #8250df;
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--text-strong) 4%, var(--surface-raised));
    line-height: 1.65;
  }

  :global(.antv-chat-body pre code) {
    padding: 0;
    background: transparent;
  }

  :global(.antv-chat-body pre code.hljs) {
    color: var(--text-strong);
  }

  :global(.antv-chat-body .hljs-comment),
  :global(.antv-chat-body .hljs-quote) {
    color: var(--syntax-comment);
    font-style: italic;
  }

  :global(.antv-chat-body .hljs-keyword),
  :global(.antv-chat-body .hljs-selector-tag),
  :global(.antv-chat-body .hljs-literal),
  :global(.antv-chat-body .hljs-section),
  :global(.antv-chat-body .hljs-link) {
    color: var(--syntax-keyword);
  }

  :global(.antv-chat-body .hljs-string),
  :global(.antv-chat-body .hljs-regexp),
  :global(.antv-chat-body .hljs-addition),
  :global(.antv-chat-body .hljs-attribute) {
    color: var(--syntax-string);
  }

  :global(.antv-chat-body .hljs-title),
  :global(.antv-chat-body .hljs-name),
  :global(.antv-chat-body .hljs-type),
  :global(.antv-chat-body .hljs-built_in),
  :global(.antv-chat-body .hljs-builtin-name) {
    color: var(--syntax-title);
  }

  :global(.antv-chat-body .hljs-number),
  :global(.antv-chat-body .hljs-meta),
  :global(.antv-chat-body .hljs-symbol),
  :global(.antv-chat-body .hljs-bullet) {
    color: var(--syntax-number);
  }

  :global(.antv-chat-body .hljs-variable),
  :global(.antv-chat-body .hljs-template-variable),
  :global(.antv-chat-body .hljs-attr),
  :global(.antv-chat-body .hljs-property),
  :global(.antv-chat-body .hljs-params) {
    color: var(--syntax-variable);
  }

  :global(.antv-chat-body .hljs-deletion) {
    color: var(--syntax-keyword);
    background: color-mix(in srgb, var(--syntax-keyword) 10%, transparent);
  }

  :global(.antv-chat-body .hljs-emphasis) {
    font-style: italic;
  }

  :global(.antv-chat-body .hljs-strong) {
    font-weight: 700;
  }

  :global(.antv-code-copy) {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(8px);
    transition: border-color .18s, color .18s, background .18s;
  }

  :global(.antv-code-copy:hover) {
    border-color: color-mix(in srgb, var(--brand) 30%, var(--border));
    background: color-mix(in srgb, var(--brand) 6%, var(--surface));
    color: var(--text-strong);
  }

  :global(.antv-code-copy[data-state='copied']) {
    border-color: color-mix(in srgb, #14804a 36%, var(--border));
    color: #14804a;
  }

  :global(.antv-code-copy[data-state='error']) {
    border-color: color-mix(in srgb, #b42318 36%, var(--border));
    color: #b42318;
  }

  :global(.antv-code-copy svg) {
    width: 14px;
    height: 14px;
    stroke-width: 1.8;
  }

  :global(.antv-code-preview) {
    max-width: 100%;
    margin: 1.2em 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-raised);
  }

  :global(.antv-code-preview-header) {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  :global(.antv-code-preview-header strong) {
    color: var(--text-strong);
    font-size: 13px;
  }

  :global(.antv-code-preview-header button) {
    min-height: 34px;
    flex: 0 0 auto;
    padding: 0 12px;
    border: 1px solid color-mix(in srgb, var(--brand) 28%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--brand) 8%, var(--surface));
    color: var(--brand-strong);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 650;
  }

  :global(.antv-code-preview-header button:disabled) {
    cursor: wait;
    opacity: .58;
  }

  :global(.antv-code-preview-stage) {
    position: relative;
    min-width: 0;
    background: #fff;
  }

  :global(.antv-code-preview-layer) {
    min-width: 0;
  }

  :global(.antv-code-preview-canvas) {
    width: 100%;
    min-height: 360px;
    overflow: auto;
    padding: 12px;
    background: #fff;
  }

  :global(.antv-code-preview-layer[data-state='staging']) {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  :global(.antv-code-preview-stage[hidden]),
  :global(.antv-code-preview-layer[hidden]),
  :global(.antv-code-preview-canvas[hidden]),
  :global(.antv-code-preview-error[hidden]) {
    display: none;
  }

  :global(.antv-code-preview-error) {
    margin: 0;
    padding: 13px 14px;
    color: #b42318;
    font-size: 13px;
    line-height: 1.55;
  }

