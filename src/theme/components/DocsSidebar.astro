---
import { localize } from '../../compiler/localization.js';
import { withBase } from '../lib/paths';
import SidebarMenu from './SidebarMenu.astro';
import type { SidebarMenuNode } from './SidebarMenu.astro';

interface Item {
  route: string;
  title: string;
  slug: string;
  order?: number;
  icon?: string;
}
interface Props {
  items: Item[];
  currentRoute: string;
  locale: 'zh' | 'en';
  catalog?: boolean;
  labels?: Record<string, { zh: string; en: string; order?: number }>;
}
interface Node {
  key: string;
  label: string;
  itemTitle?: string;
  icon?: string;
  href?: string;
  current?: boolean;
  order?: number;
  configuredIndex?: number;
  discoveredIndex: number;
  children: Node[];
}

const { items, currentRoute, locale, labels = {}, catalog = false } = Astro.props;
const section = items[0]?.slug.split('/')[0] || '';
const nodes: Node[] = [];
const configuredIndexes = new Map(
  Object.keys(labels).map((key, index) => [key, index]),
);
let discoveredIndex = 0;
const humanize = (value: string) =>
  value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());

for (const item of items) {
  const parts = item.slug.split('/');
  const relativeParts = parts[0] === section ? parts.slice(1) : parts;
  let children = nodes;
  const path = parts[0] === section ? [section] : [];

  if (relativeParts.length === 0) {
    const key = path.join('/');
    const configured = labels[key];
    nodes.push({
      key,
      label: item.title,
      itemTitle: item.title,
      icon: item.icon,
      href: withBase(item.route),
      current: item.route === currentRoute,
      order: configured?.order ?? item.order,
      configuredIndex: configuredIndexes.get(key),
      discoveredIndex: discoveredIndex++,
      children: [],
    });
    continue;
  }

  relativeParts.forEach((part, index) => {
    path.push(part);
    const key = path.join('/');
    let node = children.find((entry) => entry.key === key);
    if (!node) {
      const configured = labels[key];
      node = {
        key,
        label: configured
          ? localize({ zh: configured.zh, en: configured.en }, locale)
          : humanize(part),
        order: configured?.order,
        configuredIndex: configuredIndexes.get(key),
        discoveredIndex: discoveredIndex++,
        children: [],
      };
      children.push(node);
    }
    if (index === relativeParts.length - 1) {
      node.href = withBase(item.route);
      node.current = item.route === currentRoute;
      node.itemTitle = item.title;
      node.icon = item.icon;
      node.order ??= item.order;
    }
    children = node.children;
  });
}

const prepareNodes = (entries: Node[]): number => {
  for (const node of entries) {
    const childOrder = node.children.length
      ? prepareNodes(node.children)
      : Number.POSITIVE_INFINITY;
    if (!node.children.length && node.itemTitle) node.label = node.itemTitle;
    node.order ??= childOrder;
  }

  entries.sort((left, right) => {
    const order = (left.order ?? 0) - (right.order ?? 0);
    if (order) return order;
    if (
      left.configuredIndex !== undefined &&
      right.configuredIndex !== undefined &&
      left.configuredIndex !== right.configuredIndex
    ) {
      return left.configuredIndex - right.configuredIndex;
    }
    return left.discoveredIndex - right.discoveredIndex;
  });

  return Math.min(
    ...entries.map((node) => node.order ?? Number.POSITIVE_INFINITY),
  );
};
prepareNodes(nodes);
const catalogHref = withBase(`/${locale}/_docs/${section || 'index'}/`);
const containsCurrent = (node: Node): boolean =>
  Boolean(node.current || node.children.some(containsCurrent));
const visibleNodes = (entries: Node[]): SidebarMenuNode[] => entries.map((node) => {
  const open = catalog || containsCurrent(node);
  return {
    ...node,
    id: catalog ? node.key : undefined,
    href: node.href || `${catalogHref}#${node.key}`,
    open,
    lazy: node.children.length > 0,
    children: open ? visibleNodes(node.children) : [],
  };
});
---

<aside data-doc-sidebar={!catalog || undefined} data-doc-catalog={catalog || undefined} data-menu-url={!catalog ? catalogHref : undefined} data-pagefind-ignore class={!catalog ? "sticky top-[var(--header-height)] self-start max-h-[calc(100dvh_-_var(--header-height))] overflow-x-hidden overflow-y-auto pb-12 [border-right:1px_solid_var(--border-soft)] bg-[var(--surface-raised)] [@media(width<=900px)]:static [@media(width<=900px)]:max-h-85 [@media(width<=900px)]:mt-6 [@media(width<=900px)]:mb-8 [@media(width<=900px)]:p-4 [@media(width<=900px)]:overflow-auto [@media(width<=900px)]:[border:1px_solid_var(--border)] [@media(width<=900px)]:rounded-[var(--radius-medium)] [@media(width<=900px)]:bg-[var(--surface-subtle)] pt-2" : undefined}>
  {!catalog && items.length > 0 && <a href={catalogHref} class="block px-6 py-2 text-sm text-[var(--muted)] hover:text-[var(--brand)] focus-visible:outline-2 focus-visible:outline-[var(--brand)]">{locale === 'zh' ? '完整文档目录' : 'Full documentation index'}</a>}
  <p data-doc-load-error hidden role="status" class="m-0 px-6 py-2 text-xs text-[var(--muted)] [&[hidden]]:hidden">{locale === 'zh' ? '目录加载失败，请重新展开或访问完整文档目录。' : 'Menu unavailable. Expand again or visit the full documentation index.'}</p>
  <nav aria-label={locale === 'zh' ? '文档目录' : 'Documentation'}>
    <SidebarMenu nodes={visibleNodes(nodes)} variant="docs" />
  </nav>
</aside>

<script>
  for (const sidebar of document.querySelectorAll<HTMLElement>('[data-doc-sidebar]')) {
    const nav = sidebar.querySelector('nav')!;
    const error = sidebar.querySelector<HTMLElement>('[data-doc-load-error]')!;
    const expanded = new Set([...nav.querySelectorAll('details[open]')]
      .map((details) => (details.parentElement as HTMLElement).dataset.sidebarKey!));
    let branches: Map<string, HTMLElement> | undefined;
    let pending: Promise<void> | undefined;
    const children = (details: Element) => details.querySelector<HTMLElement>(':scope > [data-sidebar-menu]')!;
    const load = () => {
      if (branches) return Promise.resolve();
      if (pending) return pending;
      nav.setAttribute('aria-busy', 'true');
      error.hidden = true;
      pending = (async () => {
        try {
          const response = await fetch(sidebar.dataset.menuUrl!);
          if (!response.ok) throw new Error(`Menu: ${response.status}`);
          const page = new DOMParser().parseFromString(await response.text(), 'text/html');
          const catalog = page.querySelector('[data-doc-catalog]');
          if (!catalog) throw new Error('Missing document directory');
          branches = new Map([...catalog.querySelectorAll<HTMLElement>('[data-sidebar-key]')]
            .map((item) => [item.dataset.sidebarKey!, item]));
        } catch {
          error.hidden = false;
        } finally {
          pending = undefined;
          nav.removeAttribute('aria-busy');
        }
      })();
      return pending;
    };
    const prepare = (item: HTMLElement) => {
      item.removeAttribute('id');
      const details = item.querySelector<HTMLDetailsElement>(':scope > details');
      const link = item.querySelector<HTMLAnchorElement>(':scope > a, :scope > details > summary a');
      if (link && new URL(link.getAttribute('href')!, location.href).pathname === location.pathname) {
        link.setAttribute('aria-current', 'page');
        details?.querySelector('summary')!.setAttribute('data-current', 'true');
      }
      if (!details) return;
      details.open = expanded.has(item.dataset.sidebarKey!);
      if (!details.open) children(details).replaceChildren();
      else for (const child of children(details).children) prepare(child as HTMLElement);
    };
    nav.addEventListener('click', async (event) => {
      const target = event.target as Element;
      const summary = target.closest<HTMLElement>('[data-sidebar-summary]');
      if (!summary || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = target.closest('a');
      // Document titles remain navigable; directory fallback links expand in place.
      if (link && !link.getAttribute('href')?.startsWith(`${sidebar.dataset.menuUrl}#`)) return;
      event.preventDefault();
      const details = summary.parentElement as HTMLDetailsElement;
      const key = details.parentElement!.dataset.sidebarKey!;
      details.open = !details.open;
      if (!details.open) {
        expanded.delete(key);
        children(details).replaceChildren();
        return;
      }
      expanded.add(key);
      await load();
      if (!details.isConnected || !details.open) return;
      const source = branches?.get(key)?.querySelector('details');
      if (!source) return;
      const items = [...children(source).children].map((child) => {
        const item = child.cloneNode(true) as HTMLElement;
        prepare(item);
        return item;
      });
      children(details).replaceChildren(...items);
    });
  }
</script>
