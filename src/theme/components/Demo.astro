---
import { localize } from '../../compiler/localization.js';
import type { DemoRecord } from '../../compiler/content.js';
import { withBase } from '../lib/paths';
import { demoDependencies } from '../lib/demo-dependencies';
import reloadIcon from '@tabler/icons/outline/reload.svg?raw';
import stackblitzIcon from '@tabler/icons/outline/bolt.svg?raw';
import copyIcon from '@tabler/icons/outline/copy.svg?raw';
import checkIcon from '@tabler/icons/outline/check.svg?raw';
import playIcon from '@tabler/icons/outline/circle-caret-right.svg?raw';

interface Props {
  demo: DemoRecord;
  locale: 'zh' | 'en';
  height: number;
}

const { demo, locale, height } = Astro.props;
const title = localize(demo.title, locale, demo.slug);
const isZh = locale === 'zh';
const copyLabel = isZh ? '复制源码' : 'Copy source';
const toolClass = 'relative inline-flex size-7 shrink-0 items-center justify-center rounded border-0 bg-transparent p-0 text-[var(--muted)] cursor-pointer hover:bg-[var(--surface-subtle)] hover:text-[var(--brand)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)] [&_svg]:block [&_svg]:size-4 [&_svg]:stroke-[1.5] after:pointer-events-none after:absolute after:right-0 after:top-full after:z-30 after:mt-2 after:rounded-md after:bg-[#262626] after:px-2.5 after:py-1.5 after:text-xs after:font-normal after:leading-5 after:whitespace-nowrap after:text-white after:shadow-lg after:content-[attr(data-tooltip)] after:invisible after:opacity-0 hover:after:visible hover:after:opacity-100 focus-visible:after:visible focus-visible:after:opacity-100';
const exportHtml = '<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><style>html,body,#container{width:100%;height:100%;margin:0}body{font-family:sans-serif}</style></head><body><div id="container"></div></body></html>';
---

<section class="grid h-full min-h-0 min-w-0 grid-cols-[minmax(0,3fr)_minmax(0,2fr)] [@media(width<=1080px)]:h-auto [@media(width<=1080px)]:grid-cols-1" aria-labelledby="demo-title" data-example-demo data-demo-path={`/${demo.relativeSourcePath}`}>
  <div class="flex min-h-0 min-w-0 flex-col p-6 [@media(width<=700px)]:p-4">
    <h1 id="demo-title" class="m-0 mb-4 text-[20px] font-semibold text-[var(--text-strong)]">{title}</h1>
    <div data-demo-preview class="relative min-h-0 min-w-0 flex-1 overflow-hidden bg-white [@media(width<=1080px)]:min-h-80 [@media(width<=1080px)]:flex-none [@media(width<=1080px)]:h-[var(--demo-height)]" style={`--demo-height:${height}px`} aria-label={`${title} ${isZh ? '运行结果' : 'result'}`}>
      <iframe title={`${title} ${isZh ? '运行结果' : 'result'}`} src={withBase(`/demos/${demo.key}/`)} class="absolute inset-0 block size-full border-0" loading="eager" data-demo-frame></iframe>
      <pre data-demo-error role="alert" hidden class="absolute inset-x-3 top-3 z-1 m-0 max-h-full overflow-auto whitespace-pre-wrap bg-red-50 p-3 text-red-700 [&[hidden]]:hidden"></pre>
    </div>
  </div>
  <div data-demo-panel class="flex min-h-0 min-w-0 flex-col border-l border-[var(--border-soft)] [@media(width<=1080px)]:border-t [@media(width<=1080px)]:border-l-0">
    <header class="relative z-20 flex h-10 shrink-0 items-center justify-between gap-2 border-b border-[var(--border-soft)] px-3">
      <span class="text-sm leading-none font-medium text-[var(--text)]">{isZh ? '源码' : 'Source'}</span>
      <div data-demo-toolbar hidden class="flex items-center gap-1 [&[hidden]]:hidden">
        <button type="button" class={toolClass} data-demo-reset data-tooltip={isZh ? '还原源码' : 'Reset source'} aria-label={isZh ? '还原源码' : 'Reset source'} set:html={reloadIcon}></button>
        <form action="https://stackblitz.com/run?file=index.ts" method="post" target="_blank" rel="noopener noreferrer" data-demo-stackblitz class="m-0 flex items-center">
          <input type="hidden" name="project[title]" value={title} />
          <input type="hidden" name="project[description]" value={demo.key} />
          <input type="hidden" name="project[template]" value="typescript" />
          <input type="hidden" name="project[dependencies]" value={JSON.stringify(demoDependencies)} />
          <input type="hidden" name="project[files][index.html]" value={exportHtml} />
          <input type="hidden" name="project[files][index.ts]" data-demo-export-source />
          <button type="submit" class={toolClass} data-tooltip={isZh ? '在 StackBlitz 中打开' : 'Open in StackBlitz'} aria-label={isZh ? '在 StackBlitz 中打开' : 'Open in StackBlitz'} set:html={stackblitzIcon}></button>
        </form>
        <button type="button" class={`${toolClass} group/copy`} data-demo-copy data-copied={isZh ? '已复制' : 'Copied'} data-copy-error={isZh ? '复制失败' : 'Copy failed'} data-tooltip={copyLabel}>
          <span aria-hidden="true" class="group-data-[copy-state=success]/copy:hidden" set:html={copyIcon}></span>
          <span aria-hidden="true" class="hidden group-data-[copy-state=success]/copy:inline" set:html={checkIcon}></span>
          <span data-demo-copy-label class="sr-only" aria-live="polite">{copyLabel}</span>
        </button>
        <button type="button" class={toolClass} data-demo-run data-tooltip={isZh ? '运行' : 'Run'} aria-label={isZh ? '运行' : 'Run'} set:html={playIcon}></button>
      </div>
    </header>
    <pre data-demo-source class="m-0 min-h-0 flex-1 overflow-auto p-4 text-[13px] [&[hidden]]:hidden"><code class="language-ts">{demo.source}</code></pre>
    <div data-demo-editor data-label={isZh ? `${title} 源码编辑器` : `${title} source editor`} class="min-h-0 flex-1 [&_.cm-editor]:h-full [&_.cm-scroller]:max-h-none! [@media(width<=1080px)]:h-120 [@media(width<=1080px)]:flex-none"></div>
  </div>
</section>

<script>
  import '../demos/client';
</script>
