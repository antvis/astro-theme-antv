---
import demoBaseCss from '../demos/base.css?raw';
import { localize } from '../../compiler/localization.js';
import type { DemoRecord } from '../../compiler/content.js';
import { compileDemoSource, demoExportEntry } from '../../demo-source.js';
import { markdownRouteFor, withBase } from '../lib/paths';
import { dependenciesForDemo, exportConfigForDemo, filesForDemo, setupPath, setupFiles } from '../lib/demo-dependencies';
import Loading from './Loading.astro';
import DemoSource from './DemoSource.astro';
import reloadIcon from '@tabler/icons/outline/reload.svg?raw';
import stackblitzIcon from '@tabler/icons/outline/bolt.svg?raw';
import copyIcon from '@tabler/icons/outline/copy.svg?raw';
import checkIcon from '@tabler/icons/outline/check.svg?raw';
import playIcon from '@tabler/icons/outline/circle-caret-right.svg?raw';

interface Props {
  demo: DemoRecord;
  locale: 'zh' | 'en';
  height: number;
}

const { demo, locale, height } = Astro.props;
const title = localize(demo.title, locale, demo.slug);
const isZh = locale === 'zh';
const copyLabel = isZh ? '复制源码' : 'Copy source';
const toolClass = [
  // Button layout
  'relative inline-flex size-7 shrink-0 items-center justify-center rounded border-0 bg-transparent p-0 text-[var(--muted)] cursor-pointer',
  'hover:bg-[var(--surface-subtle)] hover:text-[var(--brand)]',
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand)]',
  // Icon
  '[&_svg]:block [&_svg]:size-4 [&_svg]:stroke-[1.5]',
  // Tooltip placement and appearance
  'after:pointer-events-none after:absolute after:right-0 after:top-full after:z-30 after:mt-2',
  'after:rounded-md after:bg-[#262626] after:px-2.5 after:py-1.5 after:text-xs after:font-normal after:leading-5 after:whitespace-nowrap after:text-white after:shadow-lg',
  // Tooltip content and visibility
  'after:content-[attr(data-tooltip)] after:invisible after:opacity-0',
  'hover:after:visible hover:after:opacity-100 focus-visible:after:visible focus-visible:after:opacity-100',
].join(' ');
const sourceFiles = filesForDemo(demo.source, `/${demo.relativeSourcePath}`);
const selectedFiles = { ...sourceFiles, ...setupFiles };
const demoDependencies = dependenciesForDemo(demo.source, `/${demo.relativeSourcePath}`, selectedFiles);
const demoExportConfig = exportConfigForDemo(selectedFiles);
const exportFilename = demo.relativeSourcePath.replace(/\.[^.]+$/, `.${compileDemoSource(demo.source, demo.sourcePath).sourceExtension}`);
const exportHtml = `<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><style>${demoBaseCss}html,html>body,#container{width:100%;height:100%;margin:0}</style></head><body><div id="container"></div><script type="module" src="/demo-entry.js"></script></body></html>`;
---

<section class="group/demo flex h-full min-h-0 min-w-0 [@media(width<=1080px)]:h-auto [@media(width<=1080px)]:flex-col data-[resizing]:cursor-col-resize data-[resizing]:select-none data-[resizing]:[&_iframe]:pointer-events-none" aria-labelledby="demo-title" data-example-demo data-demo-setup={setupPath} data-demo-path={`/${demo.relativeSourcePath}`}>
  <div id="demo-canvas" data-demo-canvas class="flex min-h-0 min-w-0 w-3/5 shrink-0 flex-col p-6 [@media(width<=1080px)]:w-full [@media(width<=700px)]:p-4">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h1 id="demo-title" data-pagefind-meta="title" class="m-0 text-[20px] font-semibold text-[var(--text-strong)]">{title}</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-pagefind-ignore>
        <a data-demo-markdown href={withBase(markdownRouteFor(locale, `examples/${demo.key}`))} type="text/markdown" class="text-xs text-[var(--muted)] hover:text-[var(--brand)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2">{isZh ? '查看 Markdown' : 'View Markdown'}</a>
        <a href={withBase('/llms.txt')} type="text/plain" class="sr-only focus:not-sr-only text-xs text-[var(--muted)] hover:text-[var(--brand)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2">{isZh ? '资料索引' : 'Resource index'}</a>
      </div>
    </div>
    <div data-demo-preview class="relative min-h-0 min-w-0 flex-1 overflow-hidden bg-white [@media(width<=1080px)]:min-h-80 [@media(width<=1080px)]:flex-none [@media(width<=1080px)]:h-[var(--demo-height)]" style={`--demo-height:${height}px`} aria-label={`${title} ${isZh ? '运行结果' : 'result'}`}>
      <iframe title={`${title} ${isZh ? '运行结果' : 'result'}`} src={withBase(`/demos/${demo.key}/`)} class="absolute inset-0 block size-full border-0" loading="eager" data-demo-frame></iframe>
      <div data-demo-loading class="absolute inset-0 z-1 grid place-items-center bg-white/90 [&[hidden]]:hidden">
        <Loading locale={locale} label={isZh ? '示例加载中…' : 'Loading example…'} />
      </div>
      <pre data-demo-error role="alert" hidden class="absolute inset-x-3 top-3 z-1 m-0 max-h-full overflow-auto whitespace-pre-wrap bg-red-50 p-3 text-red-700 [&[hidden]]:hidden"></pre>
    </div>
  </div>
  <div data-demo-divider hidden role="separator" tabindex="0" aria-orientation="vertical" aria-controls="demo-canvas" aria-label={isZh ? '调整画布和源码区域宽度' : 'Resize canvas and source panels'} class="relative z-10 w-px shrink-0 cursor-col-resize touch-none bg-black/10 outline-none after:absolute after:inset-y-0 after:-inset-x-[5px] after:border-x-[5px] after:border-solid after:border-transparent after:transition-colors after:duration-150 motion-reduce:after:transition-none hover:after:border-black/5 focus-visible:after:border-black/5 group-data-[resizing]/demo:after:border-black/5 [&[hidden]]:hidden [@media(width<=1080px)]:hidden"></div>
  <div data-demo-panel class="flex min-h-0 min-w-0 w-2/5 shrink-0 flex-col border-[var(--border-soft)] [@media(width<=1080px)]:w-full [@media(width<=1080px)]:border-t">
    <header class="relative z-20 flex h-10 shrink-0 items-center justify-between gap-2 border-b border-[var(--border-soft)] px-3">
      <span class="text-sm leading-none font-medium text-[var(--text)]">{isZh ? '源码' : 'Source'}</span>
      <div data-demo-toolbar hidden class="flex items-center gap-1 [&[hidden]]:hidden">
        <button type="button" class={toolClass} data-demo-reset data-tooltip={isZh ? '还原源码' : 'Reset source'} aria-label={isZh ? '还原源码' : 'Reset source'} set:html={reloadIcon}></button>
        <form action={`https://stackblitz.com/run?file=${exportFilename}`} method="post" target="_blank" rel="noopener noreferrer" data-demo-stackblitz class="m-0 flex items-center">
          <input type="hidden" name="project[title]" value={title} />
          <input type="hidden" name="project[description]" value={demo.key} />
          <input type="hidden" name="project[template]" value="node" />
          <input type="hidden" name="project[files][package.json]" data-demo-export-package value={JSON.stringify({ private: true, type: 'module', scripts: { dev: 'vite --host 0.0.0.0', start: 'vite --host 0.0.0.0' }, dependencies: demoDependencies, devDependencies: { vite: '^6.0.0', typescript: '^5.0.0' } })} />
          <input type="hidden" name="project[files][tsconfig.json]" value={JSON.stringify({ compilerOptions: { jsx: 'react-jsx', target: 'ESNext', module: 'ESNext', moduleResolution: 'Bundler', esModuleInterop: true } })} />
          {demoExportConfig && <input type="hidden" name="project[files][vite.config.mjs]" value={demoExportConfig} />}
          <input type="hidden" name="project[files][index.html]" value={exportHtml} />
          <input type="hidden" name={`project[files][${exportFilename}]`} data-demo-export-source />
          <input type="hidden" name="project[files][demo-entry.js]" value={demoExportEntry(`/${exportFilename}`, setupPath, `/${demo.relativeSourcePath}`)} data-demo-export-entry />
          {Object.entries(selectedFiles).map(([name, code]) => <input type="hidden" name={`project[files][${name}]`} value={code} data-demo-export-file={name} data-demo-setup-file={name in setupFiles ? true : undefined} />)}
          <button type="submit" class={toolClass} data-tooltip={isZh ? '在 StackBlitz 中打开' : 'Open in StackBlitz'} aria-label={isZh ? '在 StackBlitz 中打开' : 'Open in StackBlitz'} set:html={stackblitzIcon}></button>
        </form>
        <button type="button" class={`${toolClass} group/copy`} data-demo-copy data-copied={isZh ? '已复制' : 'Copied'} data-copy-error={isZh ? '复制失败' : 'Copy failed'} data-tooltip={copyLabel}>
          <span aria-hidden="true" class="group-data-[copy-state=success]/copy:hidden" set:html={copyIcon}></span>
          <span aria-hidden="true" class="hidden group-data-[copy-state=success]/copy:inline" set:html={checkIcon}></span>
          <span data-demo-copy-label class="sr-only" aria-live="polite">{copyLabel}</span>
        </button>
        <button type="button" class={toolClass} data-demo-run data-tooltip={isZh ? '运行' : 'Run'} aria-label={isZh ? '运行' : 'Run'} set:html={playIcon}></button>
      </div>
    </header>
    <DemoSource source={demo.source} path={`/${demo.relativeSourcePath}`} label={isZh ? `${title} 源码编辑器` : `${title} source editor`} isZh={isZh} gallery />
  </div>
</section>

<script>
  import '../demos/client';
</script>
