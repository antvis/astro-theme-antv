---
import { withBase } from '../lib/paths';

interface Props {
  locale: 'zh' | 'en';
  siteTitle: string;
  aliases?: Record<string, string[]>;
  pathBoosts?: Array<{ prefix: string; weight: number }>;
}

const { locale, siteTitle, aliases = {}, pathBoosts = [] } = Astro.props;
const developmentSearch = import.meta.env.ANTV_SITE_DEVELOPMENT === 'true';
---

<dialog
  class="search-dialog w-[min(800px,_calc(100%_-_32px))] max-h-[min(760px,_calc(100dvh_-_48px))] mt-[clamp(72px,_11vh,_120px)] mb-auto overflow-hidden [border:1px_solid_var(--border)] rounded-[var(--radius-large)] [background:var(--surface-raised)] text-[var(--text)] [box-shadow:0_20px_64px_rgb(29_33_41_/_18%),_0_2px_8px_rgb(29_33_41_/_6%)] mx-auto p-0 [@media(width<=700px)]:w-[calc(100%_-_16px)] [@media(width<=700px)]:max-h-[calc(100dvh_-_24px)] [@media(width<=700px)]:mt-3 [@media(width<=700px)]:rounded-[13px] [&::backdrop]:[background:rgb(29_33_41_/_42%)] [&::backdrop]:[backdrop-filter:blur(5px)_saturate(80%)]"
  data-search-dialog
  data-pagefind-ignore
  data-locale={locale}
  data-initial-message={locale === 'zh' ? '输入关键词，查找文档、API 与示例' : 'Search documentation, APIs, and examples'}
  data-loading-message={locale === 'zh' ? '正在搜索…' : 'Searching…'}
  data-empty-message={locale === 'zh' ? '没有找到相关内容' : 'No matching content found'}
  data-error-message={locale === 'zh' ? '搜索暂时不可用，请稍后重试' : 'Search is temporarily unavailable'}
  data-result-label={locale === 'zh' ? '条结果' : 'results'}
  data-document-label={locale === 'zh' ? '文档' : 'Docs'}
  data-example-label={locale === 'zh' ? '示例' : 'Example'}
  data-search-aliases={JSON.stringify(aliases)}
  data-search-path-boosts={JSON.stringify(pathBoosts)}
  data-search-mode={developmentSearch ? 'development' : 'pagefind'}
  data-search-module-url={withBase(developmentSearch ? '/pagefind/dev-index.json' : '/pagefind/pagefind.js')}
  data-pagefind-base-path={withBase('/pagefind/')}
  data-site-base-path={withBase('/')}
>
  <div class="search-panel">
    <header class="search-dialog-header flex items-center justify-between min-h-12 pt-2.5 pr-3.5 pb-2 pl-4.5 [@media(width<=700px)]:pl-3.5">
      <div class="search-dialog-brand flex items-center gap-[9px] text-[var(--muted)] text-[13px] font-semibold tracking-[0.01em]">
        <span class="search-brand-mark inline-grid w-[25px] h-[25px] place-items-center rounded-[7px] [background:var(--brand-strong)] text-[white] text-[11px] font-bold tracking-[-0.04em]" aria-hidden="true">{siteTitle.slice(0, 3)}</span>
        <span>{locale === 'zh' ? '全站搜索' : 'Site search'}</span>
      </div>
      <button class="search-close inline-flex [border:0] rounded-[var(--radius-small)] [background:transparent] text-[var(--muted)] cursor-pointer p-1 [&:hover]:[background:var(--menu-hover)] [&_kbd]:[background:var(--surface-subtle)] [&_kbd]:px-[7px] [&_kbd]:py-0.5" type="button" data-search-close aria-label={locale === 'zh' ? '关闭搜索' : 'Close search'}>
        <kbd>Esc</kbd>
      </button>
    </header>
    <div class="search-input-shell grid [grid-template-columns:24px_minmax(0,_1fr)_30px] items-center gap-2.5 [border:1px_solid_var(--border)] rounded-[11px] [background:var(--surface-subtle)] [box-shadow:inset_0_1px_2px_rgb(30_22_48_/_3%)] mx-4 my-0 px-3.5 py-0 [@media(width<=700px)]:mx-2.5 [&:focus-within]:[border-color:color-mix(in_srgb,_var(--brand)_65%,_var(--border))] [&:focus-within]:[background:var(--surface-raised)] [&:focus-within]:[box-shadow:0_0_0_3px_color-mix(in_srgb,_var(--brand)_12%,_transparent)] [&_svg]:w-[21px] [&_svg]:h-[21px] [&_svg]:[fill:none] [&_svg]:[stroke:var(--muted-light)] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-width:1.7] [&_input]:w-full [&_input]:h-14 [&_input]:[border:0] [&_input]:[outline:0] [&_input]:[background:transparent] [&_input]:text-[var(--text-strong)] [&_input]:text-[17px] [&_input]:p-0 [@media(width<=700px)]:[&_input]:h-13 [@media(width<=700px)]:[&_input]:text-[16px] [&_input::placeholder]:text-[var(--muted-light)] [&_input::-webkit-search-cancel-button]:hidden">
      <svg aria-hidden="true" viewBox="0 0 20 20">
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m13 13 4 4"></path>
      </svg>
      <input
        id="site-search-input"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="site-search-results"
        placeholder={locale === 'zh' ? '搜索本站内容…' : 'Search this site…'}
        data-search-input
      />
      <button class="search-clear grid w-6.5 h-6.5 place-items-center [border:0] rounded-[50%] [background:var(--border)] text-[var(--muted)] text-[19px] leading-[1] cursor-pointer p-0 [&:hover]:[background:var(--border-strong)] [&:hover]:text-[var(--text-strong)] [&[hidden]]:hidden" type="button" data-search-clear hidden aria-label={locale === 'zh' ? '清空搜索' : 'Clear search'}>×</button>
    </div>
    <div class="search-meta flex items-center justify-between min-h-[39px] pt-2 pb-[7px] text-[var(--muted-light)] text-[12px] px-5 [@media(width<=700px)]:px-3.5 [&_>_:first-child]:text-[var(--muted)] [&_>_:first-child]:font-semibold" aria-live="polite">
      <span>{locale === 'zh' ? '文档与示例' : 'Documentation and examples'}</span>
      <span data-search-status>{locale === 'zh' ? '输入关键词开始搜索' : 'Type to start searching'}</span>
    </div>
    <div class="search-results min-h-68 max-h-[min(480px,_calc(100dvh_-_280px))] pt-0 pb-2 overflow-y-auto [border-top:1px_solid_var(--border-soft)] [background:var(--surface-raised)] px-2 [@media(width<=700px)]:max-h-[calc(100dvh_-_230px)] [&[aria-busy=true]]:opacity-62" id="site-search-results" role="listbox" data-search-results>
      <div class="search-state grid min-h-68 place-content-center justify-items-center gap-2 text-[var(--muted-light)] text-center [&_p]:m-0" data-search-state>
        <span class="search-state-symbol grid w-10 h-10 place-items-center [border:1px_solid_var(--border)] rounded-[12px] [background:var(--surface-subtle)] text-[var(--brand)] text-[21px]" aria-hidden="true">⌕</span>
        <p>{locale === 'zh' ? '输入关键词，查找文档、API 与示例' : 'Search documentation, APIs, and examples'}</p>
      </div>
    </div>
    <footer class="search-dialog-footer flex items-center justify-end gap-4.5 min-h-10.5 [border-top:1px_solid_var(--border-soft)] [background:var(--surface-subtle)] text-[var(--muted-light)] text-[11px] px-4 py-2 [@media(width<=700px)]:justify-start [@media(width<=700px)]:gap-y-3 [@media(width<=700px)]:gap-x-3 [@media(width<=700px)]:overflow-hidden [@media(width<=700px)]:whitespace-nowrap [&_span]:inline-flex [&_span]:items-center [&_span]:gap-y-[5px] [&_span]:gap-x-[5px] [&_kbd]:min-w-5 [&_kbd]:[background:var(--surface-raised)] [&_kbd]:text-center [&_kbd]:px-1 [&_kbd]:py-[1px]" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd>{locale === 'zh' ? '选择' : 'Select'}</span>
      <span><kbd>↵</kbd>{locale === 'zh' ? '打开' : 'Open'}</span>
      <span><kbd>Esc</kbd>{locale === 'zh' ? '关闭' : 'Close'}</span>
    </footer>
    <noscript>{locale === 'zh' ? '搜索需要启用 JavaScript。' : 'Search requires JavaScript.'}</noscript>
  </div>
</dialog>
<script>
  import { mountSiteSearch } from '../features/search/client';

  mountSiteSearch();
</script>
