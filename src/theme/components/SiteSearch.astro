---
import { withBase } from '../lib/paths';

interface Props {
  locale: 'zh' | 'en';
  siteTitle: string;
  aliases?: Record<string, string[]>;
  pathBoosts?: Array<{ prefix: string; weight: number }>;
}

const { locale, siteTitle, aliases = {}, pathBoosts = [] } = Astro.props;
const developmentSearch = import.meta.env.ANTV_SITE_DEVELOPMENT === 'true';
---

<dialog
  class="search-dialog w-[min(800px,_calc(100%_-_32px))] max-h-[min(760px,_calc(100dvh_-_48px))] mt-[clamp(72px,_11vh,_120px)] mb-auto overflow-hidden [border:1px_solid_var(--border)] rounded-[var(--radius-large)] [background:var(--surface-raised)] text-[var(--text)] [box-shadow:0_20px_64px_rgb(29_33_41_/_18%),_0_2px_8px_rgb(29_33_41_/_6%)] mx-auto p-0 [@media(width<=700px)]:w-[calc(100%_-_16px)] [@media(width<=700px)]:max-h-[calc(100dvh_-_24px)] [@media(width<=700px)]:mt-3 [@media(width<=700px)]:rounded-[13px] [&::backdrop]:[background:rgb(29_33_41_/_42%)] [&::backdrop]:[backdrop-filter:blur(5px)_saturate(80%)]"
  data-search-dialog
  data-pagefind-ignore
  data-locale={locale}
  data-initial-message={locale === 'zh' ? '输入关键词，查找文档、API 与示例' : 'Search documentation, APIs, and examples'}
  data-loading-message={locale === 'zh' ? '正在搜索…' : 'Searching…'}
  data-empty-message={locale === 'zh' ? '没有找到相关内容' : 'No matching content found'}
  data-error-message={locale === 'zh' ? '搜索暂时不可用，请稍后重试' : 'Search is temporarily unavailable'}
  data-result-label={locale === 'zh' ? '条结果' : 'results'}
  data-document-label={locale === 'zh' ? '文档' : 'Docs'}
  data-example-label={locale === 'zh' ? '示例' : 'Example'}
  data-search-aliases={JSON.stringify(aliases)}
  data-search-path-boosts={JSON.stringify(pathBoosts)}
  data-search-mode={developmentSearch ? 'development' : 'pagefind'}
  data-search-module-url={withBase(developmentSearch ? '/pagefind/dev-index.json' : '/pagefind/pagefind.js')}
  data-pagefind-base-path={withBase('/pagefind/')}
  data-site-base-path={withBase('/')}
>
  <div>
    <header class="flex items-center justify-between min-h-12 pt-2.5 pr-3.5 pb-2 pl-4.5 [@media(width<=700px)]:pl-3.5">
      <div class="flex items-center gap-[9px] text-[var(--muted)] text-[13px] font-semibold tracking-[0.01em]">
        <span class="inline-grid w-[25px] h-[25px] place-items-center rounded-[7px] [background:var(--brand-strong)] text-[white] text-[11px] font-bold tracking-[-0.04em]" aria-hidden="true">{siteTitle.slice(0, 3)}</span>
        <span>{locale === 'zh' ? '全站搜索' : 'Site search'}</span>
      </div>
      <button class="inline-flex [border:0] rounded-[var(--radius-small)] [background:transparent] text-[var(--muted)] cursor-pointer p-1 [&:hover]:[background:var(--menu-hover)] [&_kbd]:[background:var(--surface-subtle)] [&_kbd]:px-[7px] [&_kbd]:py-0.5" type="button" data-search-close aria-label={locale === 'zh' ? '关闭搜索' : 'Close search'}>
        <kbd>Esc</kbd>
      </button>
    </header>
    <div class="[transition:border-color_0.16s,box-shadow_0.16s,background_0.16s] grid [grid-template-columns:24px_minmax(0,_1fr)_30px] items-center gap-2.5 [border:1px_solid_var(--border)] rounded-[11px] [background:var(--surface-subtle)] [box-shadow:inset_0_1px_2px_rgb(30_22_48_/_3%)] mx-4 my-0 px-3.5 py-0 [@media(width<=700px)]:mx-2.5 [&:focus-within]:[border-color:color-mix(in_srgb,_var(--brand)_65%,_var(--border))] [&:focus-within]:[background:var(--surface-raised)] [&:focus-within]:[box-shadow:0_0_0_3px_color-mix(in_srgb,_var(--brand)_12%,_transparent)] [&_svg]:w-[21px] [&_svg]:h-[21px] [&_svg]:[fill:none] [&_svg]:[stroke:var(--muted-light)] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-width:1.7] [&_input]:w-full [&_input]:h-14 [&_input]:[border:0] [&_input]:[outline:0] [&_input]:[background:transparent] [&_input]:text-[var(--text-strong)] [&_input]:text-[17px] [&_input]:p-0 [@media(width<=700px)]:[&_input]:h-13 [@media(width<=700px)]:[&_input]:text-[16px] [&_input::placeholder]:text-[var(--muted-light)] [&_input::-webkit-search-cancel-button]:hidden">
      <svg aria-hidden="true" viewBox="0 0 20 20">
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m13 13 4 4"></path>
      </svg>
      <input
        id="site-search-input"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="site-search-results"
        placeholder={locale === 'zh' ? '搜索本站内容…' : 'Search this site…'}
        data-search-input
      />
      <button class="grid w-6.5 h-6.5 place-items-center [border:0] rounded-[50%] [background:var(--border)] text-[var(--muted)] text-[19px] leading-[1] cursor-pointer p-0 [&:hover]:[background:var(--border-strong)] [&:hover]:text-[var(--text-strong)] [&[hidden]]:hidden" type="button" data-search-clear hidden aria-label={locale === 'zh' ? '清空搜索' : 'Clear search'}>×</button>
    </div>
    <div class="flex items-center justify-between min-h-[39px] pt-2 pb-[7px] text-[var(--muted-light)] text-[12px] px-5 [@media(width<=700px)]:px-3.5 [&_>_:first-child]:text-[var(--muted)] [&_>_:first-child]:font-semibold" aria-live="polite">
      <span>{locale === 'zh' ? '文档与示例' : 'Documentation and examples'}</span>
      <span data-search-status>{locale === 'zh' ? '输入关键词开始搜索' : 'Type to start searching'}</span>
    </div>
    <div class="min-h-68 max-h-[min(480px,_calc(100dvh_-_280px))] pt-0 pb-2 overflow-y-auto [border-top:1px_solid_var(--border-soft)] [background:var(--surface-raised)] px-2 [@media(width<=700px)]:max-h-[calc(100dvh_-_230px)] [&[aria-busy=true]]:opacity-62" id="site-search-results" role="listbox" data-search-results>
      <div class="grid min-h-68 place-content-center justify-items-center gap-2 text-[var(--muted-light)] text-center [&_p]:m-0" data-search-state>
        <span class="grid w-10 h-10 place-items-center [border:1px_solid_var(--border)] rounded-[12px] [background:var(--surface-subtle)] text-[var(--brand)] text-[21px]" aria-hidden="true">⌕</span>
        <p>{locale === 'zh' ? '输入关键词，查找文档、API 与示例' : 'Search documentation, APIs, and examples'}</p>
      </div>
    </div>
    <footer class="flex items-center justify-end gap-4.5 min-h-10.5 [border-top:1px_solid_var(--border-soft)] [background:var(--surface-subtle)] text-[var(--muted-light)] text-[11px] px-4 py-2 [@media(width<=700px)]:justify-start [@media(width<=700px)]:gap-y-3 [@media(width<=700px)]:gap-x-3 [@media(width<=700px)]:overflow-hidden [@media(width<=700px)]:whitespace-nowrap [&_span]:inline-flex [&_span]:items-center [&_span]:gap-y-[5px] [&_span]:gap-x-[5px] [&_kbd]:min-w-5 [&_kbd]:[background:var(--surface-raised)] [&_kbd]:text-center [&_kbd]:px-1 [&_kbd]:py-[1px]" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd>{locale === 'zh' ? '选择' : 'Select'}</span>
      <span><kbd>↵</kbd>{locale === 'zh' ? '打开' : 'Open'}</span>
      <span><kbd>Esc</kbd>{locale === 'zh' ? '关闭' : 'Close'}</span>
    </footer>
    <noscript>{locale === 'zh' ? '搜索需要启用 JavaScript。' : 'Search requires JavaScript.'}</noscript>
  </div>
</dialog>
<script>
  interface SearchRecordData {
    url: string;
    meta?: { title?: string };
    plain_excerpt?: string;
  }

  interface SearchResult {
    score: number;
    data: () => Promise<SearchRecordData>;
  }

  interface SearchResponse {
    results: SearchResult[];
  }

  interface SearchInstance {
    search: (term: string) => Promise<SearchResponse>;
  }

  interface PagefindInstance extends SearchInstance {
    init: () => Promise<void>;
  }

  interface PagefindModule {
    createInstance: (options: {
      basePath: string;
      language: string;
    }) => PagefindInstance;
  }

  interface LoadedSearchResult {
    score: number;
    data: SearchRecordData;
  }

  interface PathBoost {
    prefix?: string;
    weight?: number;
  }

  function mountSiteSearch(): void {
      const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
      const resultsRoot = dialog?.querySelector<HTMLElement>('[data-search-results]');
      const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
      const clearButton = dialog?.querySelector<HTMLButtonElement>('[data-search-clear]');
      if (!dialog || !input || !resultsRoot || !status || !clearButton) return;

      const locale = dialog.dataset.locale || 'en';
      const parseConfiguration = <Value,>(value: string | undefined, fallback: Value): Value => {
        try {
          return (JSON.parse(value || '') as Value) || fallback;
        } catch {
          return fallback;
        }
      };
      const aliases = parseConfiguration<Record<string, string[]>>(
        dialog.dataset.searchAliases,
        {},
      );
      const pathBoosts = parseConfiguration<PathBoost[]>(
        dialog.dataset.searchPathBoosts,
        [],
      );
      const searchMode = dialog.dataset.searchMode || 'pagefind';
      const searchModuleUrl = dialog.dataset.searchModuleUrl || '/pagefind/pagefind.js';
      const pagefindBasePath = dialog.dataset.pagefindBasePath || '/pagefind/';
      const siteBasePath = dialog.dataset.siteBasePath || '/';
      const siteBasePrefix = siteBasePath === '/' ? '' : siteBasePath.replace(/\/$/, '');
      let searchPromise: Promise<SearchInstance> | undefined;
      let searchTimer: number | undefined;
      let searchSequence = 0;
      let selectedIndex = -1;

      const normalize = (value: unknown) => String(value || '').toLocaleLowerCase().replace(/\s+/g, '');
      const withoutSiteBase = (pathname: string) => {
        if (!siteBasePrefix) return pathname;
        if (pathname === siteBasePrefix) return '/';
        return pathname.startsWith(`${siteBasePrefix}/`)
          ? pathname.slice(siteBasePrefix.length)
          : pathname;
      };
      const withSiteBase = (pathname: string) => {
        if (!siteBasePrefix || pathname === siteBasePrefix || pathname.startsWith(`${siteBasePrefix}/`)) {
          return pathname;
        }
        return `${siteBasePrefix}${pathname.startsWith('/') ? pathname : `/${pathname}`}`;
      };
      const getAliasTerms = (query: string) => aliases[normalize(query)] || [];
      const resultRank = ({ score, data }: LoadedSearchResult, query: string) => {
        const normalizedQuery = normalize(query);
        const title = normalize(data.meta?.title || '');
        const url = normalize(data.url || '');
        const excerpt = normalize(data.plain_excerpt || '');
        const aliasTerms = getAliasTerms(query);
        let boost = 0;
        if (title === normalizedQuery) boost += 10000;
        else if (title.startsWith(normalizedQuery)) boost += 6500;
        else if (title.includes(normalizedQuery)) boost += 4500;
        if (url.includes(normalizedQuery)) boost += 2200;
        if (aliasTerms.some((alias) => url.includes(alias))) boost += 3200;
        if (aliasTerms.some((alias) => title.includes(alias))) boost += 1800;
        for (const rule of pathBoosts) {
          if (url.includes(normalize(rule?.prefix))) {
            boost += Number(rule?.weight) || 0;
          }
        }
        if (excerpt.includes(normalizedQuery)) boost += 300;
        return boost + Math.log1p(Math.max(0, Number(score) || 0)) * 100;
      };

      const setState = (message: string | undefined, symbol = '⌕') => {
        const state = document.createElement('div');
        state.className = 'grid min-h-68 place-content-center justify-items-center gap-2 text-[var(--muted-light)] text-center [&_p]:m-0';
        state.dataset.searchState = '';
        const icon = document.createElement('span');
        icon.className = 'grid w-10 h-10 place-items-center [border:1px_solid_var(--border)] rounded-[12px] [background:var(--surface-subtle)] text-[var(--brand)] text-[21px]';
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = symbol;
        const text = document.createElement('p');
        text.textContent = message ?? '';
        state.append(icon, text);
        resultsRoot.replaceChildren(state);
        selectedIndex = -1;
        input?.removeAttribute('aria-activedescendant');
      };

      const appendHighlightedText = (element: HTMLElement, value: unknown, query: string) => {
        const text = String(value || '');
        const normalizedText = text.toLocaleLowerCase();
        const normalizedQuery = String(query || '').toLocaleLowerCase();
        let cursor = 0;
        let match = normalizedText.indexOf(normalizedQuery);
        if (!normalizedQuery || match < 0) {
          element.textContent = text;
          return;
        }
        while (match >= 0) {
          element.append(document.createTextNode(text.slice(cursor, match)));
          const mark = document.createElement('mark');
          mark.textContent = text.slice(match, match + normalizedQuery.length);
          element.append(mark);
          cursor = match + normalizedQuery.length;
          match = normalizedText.indexOf(normalizedQuery, cursor);
        }
        element.append(document.createTextNode(text.slice(cursor)));
      };

      const displayPath = (url: string) => {
        const pathname = withoutSiteBase(new URL(url, location.origin).pathname);
        const localizedPrefix = `/${locale}/`;
        return pathname
          .replace(localizedPrefix, '/')
          .replace(/^\//, '')
          .replace(/\/$/, '')
          .split('/')
          .join(' / ');
      };

      const updateSelection = (nextIndex: number) => {
        const options = [...resultsRoot.querySelectorAll<HTMLElement>('[role="option"]')];
        if (!options.length) return;
        selectedIndex = (nextIndex + options.length) % options.length;
        options.forEach((option, index) => {
          const selected = index === selectedIndex;
          option.setAttribute('aria-selected', String(selected));
          option.toggleAttribute('data-selected', selected);
        });
        const active = options[selectedIndex];
        input.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      };

      const renderResults = (records: LoadedSearchResult[], query: string) => {
        const fragment = document.createDocumentFragment();
        records.forEach(({ data }, index) => {
          const parsedUrl = new URL(data.url, location.origin);
          const href = `${withSiteBase(parsedUrl.pathname)}${parsedUrl.search}${parsedUrl.hash}`;
          const isExample = withoutSiteBase(parsedUrl.pathname).includes('/examples/');
          const option = document.createElement('a');
          option.id = `site-search-result-${index}`;
          option.className = '[transition:background_0.12s,color_0.12s] before:content-[""] relative block pt-[13px] pr-4 pb-3 pl-4.5 [border-bottom:1px_solid_var(--border-soft)] rounded-[8px] text-[var(--text)] [@media(width<=700px)]:pr-3 [@media(width<=700px)]:pl-3.5 [&::before]:absolute [&::before]:top-3 [&::before]:bottom-3 [&::before]:left-0 [&::before]:w-0.5 [&::before]:rounded-[2px] [&::before]:[background:var(--brand)] [&::before]:opacity-0 [&[data-selected]]:[background:var(--brand-soft)] [&[data-selected]]:text-[var(--text)] [&[data-selected]::before]:opacity-100 [&_mark]:[background:transparent] [&_mark]:text-[var(--brand-strong)] [&_mark]:p-0';
          option.href = href;
          option.setAttribute('role', 'option');
          option.setAttribute('aria-selected', String(index === 0));
          option.toggleAttribute('data-selected', index === 0);

          const heading = document.createElement('div');
          heading.className = 'flex items-center gap-2.5 [&_strong]:overflow-hidden [&_strong]:text-[var(--text-strong)] [&_strong]:text-[15px] [&_strong]:font-semibold [&_strong]:leading-[1.45] [&_strong]:text-ellipsis [&_strong]:whitespace-nowrap';
          const title = document.createElement('strong');
          appendHighlightedText(title, data.meta?.title || displayPath(data.url), query);
          const badge = document.createElement('span');
          badge.className = `[flex:none] [border:1px_solid_color-mix(in_srgb,_var(--brand)_20%,_var(--border))] rounded-[999px] [background:color-mix(in_srgb,_var(--brand-soft)_48%,_transparent)] text-[var(--brand-strong)] text-[10px] font-semibold leading-[17px] px-1.5 py-[1px] [&.is-example]:[border-color:color-mix(in_srgb,_var(--success)_24%,_var(--border))] [&.is-example]:[background:color-mix(in_srgb,_var(--success)_8%,_transparent)] [&.is-example]:text-[var(--success)]${isExample ? ' is-example' : ''}`;
          badge.textContent = isExample
            ? dialog.dataset.exampleLabel ?? ''
            : dialog.dataset.documentLabel ?? '';
          heading.append(title, badge);

          const path = document.createElement('span');
          path.className = '[font-family:SFMono-Regular,Consolas,Liberation_Mono,Menlo,monospace] block mt-0.5 overflow-hidden text-[var(--muted-light)] text-[11px] text-ellipsis whitespace-nowrap';
          path.textContent = displayPath(data.url);
          const excerpt = document.createElement('p');
          excerpt.className = '[display:-webkit-box] mt-1.5 mb-0 overflow-hidden text-[var(--muted)] text-[12px] leading-[1.55] [-webkit-box-orient:vertical] [-webkit-line-clamp:1] mx-0';
          appendHighlightedText(excerpt, data.plain_excerpt || '', query);
          option.append(heading, path, excerpt);
          option.addEventListener('pointermove', () => updateSelection(index));
          fragment.append(option);
        });
        resultsRoot.replaceChildren(fragment);
        selectedIndex = records.length ? 0 : -1;
        if (records.length) input.setAttribute('aria-activedescendant', 'site-search-result-0');
      };

      const createDevelopmentSearch = async (): Promise<SearchInstance> => {
        const response = await fetch(searchModuleUrl, { cache: 'no-store' });
        if (!response.ok) throw new Error(`Development search index returned ${response.status}.`);
        const records = await response.json();
        const languageRecords: Array<Record<string, unknown>> = Array.isArray(records)
          ? records.filter(
              (record): record is Record<string, unknown> =>
                typeof record === 'object' &&
                record !== null &&
                Reflect.get(record, 'language') === locale,
            )
          : [];
        return {
          async search(term: string) {
            const query = normalize(term);
            if (!query) return { results: [] };
            const results = languageRecords.flatMap((record) => {
              const title = String(record.title || '');
              const content = String(record.content || '');
              const normalizedTitle = normalize(title);
              const normalizedContent = normalize(content);
              const titleIndex = normalizedTitle.indexOf(query);
              const contentIndex = normalizedContent.indexOf(query);
              if (titleIndex < 0 && contentIndex < 0) return [];
              const score = (titleIndex === 0 ? 100 : titleIndex >= 0 ? 50 : 0) +
                Math.max(1, 20 - Math.max(0, contentIndex));
              const plainExcerpt = content.replace(/\s+/g, ' ').trim().slice(0, 220);
              return [{
                score,
                data: async () => ({
                  url: String(record.url || ''),
                  meta: { title },
                  plain_excerpt: plainExcerpt,
                }),
              }];
            });
            return { results };
          },
        };
      };

      const mountSearch = (): Promise<SearchInstance> => {
        if (!searchPromise) {
          searchPromise = (searchMode === 'development'
            ? createDevelopmentSearch()
            : import(/* @vite-ignore */ searchModuleUrl).then(async (pagefind: unknown) => {
              const instance = (pagefind as PagefindModule).createInstance({
                basePath: pagefindBasePath,
                language: document.documentElement.lang,
              });
              await instance.init();
              return instance;
            }))
            .catch((error) => {
              searchPromise = undefined;
              throw error;
            });
        }
        return searchPromise;
      };

      const performSearch = async (query: string, sequence: number) => {
        const normalizedQuery = query.trim();
        if (!normalizedQuery) {
          resultsRoot.removeAttribute('aria-busy');
          status.textContent = locale === 'zh' ? '输入关键词开始搜索' : 'Type to start searching';
          setState(dialog.dataset.initialMessage);
          return;
        }
        status.textContent = dialog.dataset.loadingMessage ?? '';
        resultsRoot.setAttribute('aria-busy', 'true');
        try {
          const instance = await mountSearch();
          const queries = [normalizedQuery, ...getAliasTerms(normalizedQuery)];
          const responses = await Promise.all(queries.map((term) => instance.search(term)));
          if (sequence !== searchSequence) return;
          const candidates = responses.flatMap((response) => response.results.slice(0, 40));
          const loaded = await Promise.all(candidates.map(async (result) => ({
            score: result.score,
            data: await result.data(),
          })));
          if (sequence !== searchSequence) return;
          const unique = new Map<string, LoadedSearchResult>();
          loaded.forEach((record) => {
            const key = new URL(record.data.url, location.origin).pathname;
            const previous = unique.get(key);
            if (!previous || Number(record.score) > Number(previous.score)) unique.set(key, record);
          });
          const ranked = [...unique.values()]
            .sort((left, right) => resultRank(right, normalizedQuery) - resultRank(left, normalizedQuery))
            .slice(0, 8);
          if (ranked.length) {
            renderResults(ranked, normalizedQuery);
            status.textContent = `${unique.size} ${dialog.dataset.resultLabel}`;
          } else {
            status.textContent = dialog.dataset.emptyMessage ?? '';
            setState(dialog.dataset.emptyMessage, '-');
          }
        } catch (error) {
          if (sequence !== searchSequence) return;
          console.error('Failed to search documentation.', error);
          status.textContent = dialog.dataset.errorMessage ?? '';
          setState(dialog.dataset.errorMessage, '!');
        } finally {
          if (sequence === searchSequence) resultsRoot.removeAttribute('aria-busy');
        }
      };

      const queueSearch = () => {
        if (searchTimer !== undefined) clearTimeout(searchTimer);
        const query = input.value;
        clearButton.toggleAttribute('hidden', !query);
        const sequence = ++searchSequence;
        searchTimer = window.setTimeout(() => performSearch(query, sequence), 100);
      };

      const openSearch = async () => {
        if (!dialog.open) dialog.showModal();
        input.setAttribute('aria-expanded', 'true');
        window.setTimeout(() => input.focus(), 0);
        try {
          await mountSearch();
        } catch (error) {
          console.error('Failed to load document search.', error);
          status.textContent = dialog.dataset.errorMessage ?? '';
          setState(dialog.dataset.errorMessage, '!');
        }
      };
      document.querySelector('[data-search-open]')?.addEventListener('click', openSearch);
      document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
      input.addEventListener('input', queueSearch);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          updateSelection(selectedIndex + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          updateSelection(selectedIndex - 1);
        } else if (event.key === 'Enter' && selectedIndex >= 0) {
          event.preventDefault();
          resultsRoot.querySelectorAll<HTMLAnchorElement>('[role="option"]')[selectedIndex]?.click();
        }
      });
      clearButton.addEventListener('click', () => {
        input.value = '';
        input.focus();
        queueSearch();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => input.setAttribute('aria-expanded', 'false'));
      window.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          openSearch();
        }
        if (event.key === 'Escape' && dialog.open) dialog.close();
      });
  }

  mountSiteSearch();
</script>
