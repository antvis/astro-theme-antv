<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Demo preview</title>
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      html, body, #container { width: 100%; height: 100%; margin: 0; }
      body { background: #fff; font-family: sans-serif; }
    </style>
  </head>
  <body>
    <div id="container"></div>
    <script>
      import { dependencies } from 'virtual:antv-demo-dependencies';
      import { runDemo } from '../../demos/runtime';

      const send = (type: string, error?: string) => parent.postMessage({ type, error }, location.origin);
      let started = false;
      const showError = (error: unknown) => {
        send('antv-demo:error', error instanceof Error ? error.message : String(error));
      };
      addEventListener('error', (event) => showError(event.error || event.message));
      addEventListener('unhandledrejection', (event) => showError(event.reason));
      addEventListener('message', async (event) => {
        if (event.source !== parent || event.origin !== location.origin || started) return;
        const message = event.data;
        if (message?.type !== 'antv-demo:run' || typeof message.source !== 'string' || typeof message.path !== 'string') return;
        started = true;
        try {
          await runDemo(message.source, message.path, dependencies);
          send('antv-demo:complete');
        } catch (error) { showError(error); }
      });
      if (parent !== window) send('antv-demo:ready');
    </script>
  </body>
</html>
