---
import type { SitePage } from '../../../compiler/content.js';
import { config, registry } from '../../lib/site';
import Qa from '../../components/Qa.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

type QaPage = Extract<SitePage, { type: 'qa' }>;

interface Props {
  page: QaPage;
}

export function getStaticPaths() {
  return registry.pages
    .filter((page): page is QaPage => page.type === 'qa')
    .map((page) => ({
      params: { locale: page.locale },
      props: { page },
    }));
}

const { page } = Astro.props;
const locale = page.locale;
const isZh = locale === 'zh';
const title = isZh ? 'AI 问答' : 'AI Q&A';
const description = isZh
  ? '与 AI 助手交流，获取可视化创作与图表使用方面的帮助。'
  : 'Ask the AI assistant for help creating visualizations and using charts.';
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  route={page.route}
  pageType="qa"
>
  {config.qa && <Qa locale={locale} service={config.qa.service} route={page.route} />}
</BaseLayout>
