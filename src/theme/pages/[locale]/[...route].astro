---
import { render } from 'astro:content';
import copyIcon from '@tabler/icons/outline/copy.svg?raw';
import editIcon from '@tabler/icons/outline/pencil.svg?raw';
import checkIcon from '@tabler/icons/outline/check.svg?raw';
import markdownIcon from '@tabler/icons/outline/markdown.svg?raw';
import { localize } from '../../../compiler/localization.js';
import type { SitePage } from '../../../compiler/content.js';
import { getDocsCollection } from '../../lib/docs';
import { toDocumentPage } from '../../lib/documents';
import type { DocumentPage } from '../../lib/documents';
import { markdownRouteFor, withBase } from '../../lib/paths';
import DocsSidebar from '../../components/DocsSidebar.astro';
import ExampleSidebar from '../../components/ExampleSidebar.astro';
import Toc from '../../components/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Demo from '../../components/Demo.astro';
import {
  categoriesBySlug,
  config,
  demosByKey,
  groupsByKey,
  registry,
} from '../../lib/site';

type RoutePage = Exclude<SitePage, { type: 'home' | 'qa' }> | DocumentPage;

interface Props {
  page: RoutePage;
}

export async function getStaticPaths() {
  const entries = await getDocsCollection();
  const documentPages = entries
    .map((entry) => toDocumentPage(entry, config))
    .filter((page) => config.site.locales.includes(page.locale));
  const generatedPages = registry.pages.filter(
    (page): page is Exclude<SitePage, { type: 'home' | 'qa' }> =>
      page.type !== 'home' && page.type !== 'qa',
  );
  // Generated routes are checked by scanSite; documents come from Astro's collection.
  const knownRoutes = new Set(registry.pages.map((page) => page.route));
  for (const page of documentPages) {
    if (knownRoutes.has(page.route)) {
      throw new Error(`Duplicate Astro route: ${page.route}`);
    }
    knownRoutes.add(page.route);
  }

  return [...generatedPages, ...documentPages]
    .map((page) => ({
      params: {
        locale: page.locale,
        route: page.route.replace(new RegExp(`^/${page.locale}/?`), '').replace(/\/$/, ''),
      },
      props: { page },
    }));
}

const { page } = Astro.props;
if (page.type === 'document') Astro.locals.antvDocument = page.entry;
const locale = page.locale;
const isZh = locale === 'zh';
const documentSection = page.type === 'document' ? page.section : undefined;
const documentEntries = page.type === 'document'
  ? await getDocsCollection()
  : [];
const documentItems = documentEntries
  .filter((entry) => !entry.data.sidebar.hidden)
  .map((entry) => toDocumentPage(entry, config))
  .filter((item) => item.locale === locale && item.section === documentSection)
  .map((item) => ({
    ...item,
    title: item.entry.data.sidebar.label || item.title,
    icon: item.entry.data.sidebar.icon,
  }))
  .sort((a, b) => a.order - b.order || a.slug.localeCompare(b.slug));
const renderedDocument = page.type === 'document' ? await render(page.entry) : undefined;
const DocumentContent = renderedDocument?.Content;
const category = page.type === 'example-category'
  ? categoriesBySlug.get(page.categorySlug)
  : undefined;
const group = page.type === 'example-group'
  ? groupsByKey.get(page.groupKey)
  : undefined;
// Keep existing group/category URLs usable without an intermediate listing page.
if (group || category) {
  const firstDemo = group?.demos[0] ?? category?.groups.flatMap((item) => item.demos)[0];
  return Astro.redirect(withBase(firstDemo ? `/${locale}/examples/${firstDemo.key}/` : `/${locale}/examples/`), 301);
}
const demo = page.type === 'demo' ? demosByKey.get(page.demoKey) : undefined;
const editConfig = config.content.edit;
const markdownHref = page.type === 'document'
  ? withBase(markdownRouteFor(locale, page.slug))
  : undefined;
const repositoryPath = (...parts: string[]) =>
  parts
    .flatMap((part) => part.split('/'))
    .filter(Boolean)
    .map(encodeURIComponent)
    .join('/');
const editHref = editConfig && page.type === 'document' && page.sourcePath
  ? `${config.site.repository.replace(/\/$/, '')}/edit/${repositoryPath(
      editConfig.branch,
      editConfig.path,
      page.sourcePath,
    )}`
  : undefined;
const groupAnchor = (categorySlug: string, groupSlug: string) =>
  `group-${categorySlug}-${groupSlug.replaceAll('/', '-')}`;

let title = config.site.title;
let description = localize(config.site.description, locale);
if (page.type === 'document') {
  title = page.title;
  description = page.description;
} else if (page.type === 'examples') {
  title = isZh ? '图表示例' : 'Examples';
} else if (category) {
  title = localize(category.title, locale);
} else if (group) {
  title = localize(group.title, locale);
} else if (demo) {
  title = localize(demo.title, locale, demo.slug);
  description = isZh ? `${title} 的完整源码与可运行结果。` : `Complete source and live result for ${title}.`;
}
---

<BaseLayout locale={locale} title={title} description={description} route={page.route} pageType={page.type === 'document' ? 'document' : demo ? 'demo' : 'page'} image={page.type === 'document' ? page.entry.data.screenshot : demo?.screenshot} openGraph={page.type === 'document' ? page.entry.data.openGraph : demo?.openGraph}>
  {page.type === 'document' && (page.entry.data.template === 'page' ? (
    <section aria-label={page.title}>
      <h1 class="sr-only" data-pagefind-meta="title">{page.title}</h1>
      {DocumentContent && <DocumentContent />}
    </section>
  ) : (
    <div class="grid grid-cols-[var(--docs-sidebar-width)_minmax(0,1fr)_var(--toc-width)] w-[var(--content-width)] mx-auto pt-6 pb-16 bg-[var(--surface-raised)] [@media(900px<width<=1320px)]:grid-cols-[240px_minmax(0,1fr)] [@media(width<=900px)]:block [@media(width<=900px)]:w-[min(100%_-_36px,820px)]">
      <DocsSidebar items={documentItems} currentRoute={page.route} locale={locale} labels={config.content.sidebar} />
      <article class="markdown-body">
        <h1 data-pagefind-meta="title">{page.title}</h1>
        <div class="flex flex-wrap items-center justify-end gap-4 mb-6 pb-3 [border-bottom:1px_solid_var(--border-soft)] text-[12px] leading-[1.5] [@media(width<=700px)]:justify-start" data-pagefind-ignore>
          <a href={markdownHref} type="text/markdown" class="inline-flex items-center gap-1.5 text-[var(--muted)] hover:text-[var(--muted)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current">
            <span class="inline-flex size-3.5 [&_svg]:size-full" aria-hidden="true" set:html={markdownIcon} />
            {isZh ? '查看 Markdown' : 'View Markdown'}
          </a>
          <button
            type="button"
            hidden
            data-copy-document={markdownHref}
            class="group/copy inline-flex items-center gap-1.5 border-0 bg-transparent p-0 [font:inherit] text-[var(--muted)] cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current [&[hidden]]:hidden"
            title={isZh ? '复制当前文档的 Markdown' : 'Copy this document as Markdown'}
          >
            <span class="inline-flex size-3.5 [&_svg]:size-full group-data-[copy-state=success]/copy:hidden" aria-hidden="true" set:html={copyIcon} />
            <span class="hidden size-3.5 [&_svg]:size-full group-data-[copy-state=success]/copy:inline-flex" aria-hidden="true" set:html={checkIcon} />
            <span data-copy-label role="status" aria-live="polite">{isZh ? '复制文档' : 'Copy document'}</span>
          </button>
          {editHref && (
            <a href={editHref} class="inline-flex items-center gap-1.5 text-[var(--muted)] hover:text-[var(--muted)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current">
              <span class="inline-flex size-3.5 [&_svg]:size-full" aria-hidden="true" set:html={editIcon} />
              {localize(editConfig?.label, locale, isZh ? '编辑此页' : 'Edit this page')}
            </a>
          )}
        </div>
        {DocumentContent && <DocumentContent />}
      </article>
      <Toc headings={renderedDocument?.headings || []} locale={locale} />
    </div>
  ))}

  {page.type === 'examples' && (
    <div class="grid w-[var(--content-width)] mx-auto bg-[var(--surface-raised)] [@media(width<=900px)]:block [@media(width<=900px)]:w-[min(100%_-_36px,820px)] grid-cols-[var(--docs-sidebar-width)_minmax(0,1fr)] [@media(900px<width<=1320px)]:grid-cols-[240px_minmax(0,1fr)]">
      <ExampleSidebar categories={registry.categories} locale={locale} currentRoute={page.route} />
      <section class="min-w-0 pt-8 px-12 pb-24 bg-[var(--surface-raised)] [@media(width<=900px)]:px-0">
        <div class="grid gap-16 [@media(width<=700px)]:gap-y-12 [@media(width<=700px)]:gap-x-12">
          {registry.categories.map((item) => {
            const demoCount = item.groups.reduce((sum, entry) => sum + entry.demos.length, 0);
            if (!demoCount) return null;
            return (
              <section class="[scroll-margin-top:calc(var(--header-height)_+_24px)]" id={`category-${item.slug}`} data-example-category={item.slug}>
                <header class="[&_span]:[font-family:SFMono-Regular,Consolas,monospace] flex items-baseline justify-between gap-6 mb-7 pb-3.5 [border-bottom:1px_solid_var(--border-soft)] [@media(width<=700px)]:gap-y-4 [@media(width<=700px)]:gap-x-4 [&_h2]:text-[var(--text-strong)] [&_h2]:font-medium [&_h2]:text-[24px] [&_h2]:m-0 [&_span]:[flex:none] [&_span]:text-[var(--muted-light)] [&_span]:text-[11px]">
                  <h2>{localize(item.title, locale)}</h2>
                  <span>{demoCount} {isZh ? '个示例' : 'examples'}</span>
                </header>
                {item.groups.map((entry) => (
                  <section class="catalog-group [scroll-margin-top:calc(var(--header-height)_+_24px)] [&_+_.catalog-group]:mt-11" id={groupAnchor(item.slug, entry.slug)} data-example-group={`${item.slug}/${entry.slug}`}>
                    <header class="[&_a]:[font-family:SFMono-Regular,Consolas,monospace] flex items-baseline justify-between gap-6 mb-4.5 [@media(width<=700px)]:gap-y-4 [@media(width<=700px)]:gap-x-4 [&_h3]:text-[var(--text-strong)] [&_h3]:font-medium [&_h3]:text-[20px] [&_h3]:leading-[30px] [&_h3]:m-0 [&_a]:[flex:none] [&_a]:text-[var(--muted-light)] [&_a]:text-[11px] [&_a:hover]:text-[var(--brand)]">
                      <h3>{localize(entry.title, locale)}</h3>
                      <a href={withBase(entry.demos[0] ? `/${locale}/examples/${entry.demos[0].key}/` : `/${locale}/examples/`)}>
                        {entry.demos.length} {isZh ? '个示例' : 'examples'}
                      </a>
                    </header>
                    <div class="grid grid-cols-4 gap-x-6 gap-y-7 [@media(900px<width<=1320px)]:grid-cols-3 [@media(700px<width<=900px)]:grid-cols-2 [@media(width<=700px)]:grid-cols-1">
                      {entry.demos.map((demoItem) => {
                        const demoTitle = localize(demoItem.title, locale, demoItem.slug);
                        return (
                          <a href={withBase(`/${locale}/examples/${demoItem.key}/`)} aria-label={demoTitle} class="group/demo min-w-0 text-[var(--text-strong)] hover:text-[var(--text-strong)]">
                            <div class="bg-[var(--surface-raised)] [transition:border-color_0.25s,box-shadow_0.25s,transform_0.25s] flex [aspect-ratio:16_/_10] items-center justify-center mb-3.5 overflow-hidden [border:1px_solid_var(--border-soft)] rounded-[var(--radius-small)] [&_img]:w-full [&_img]:h-full [&_img]:[object-fit:scale-down] group-hover/demo:[box-shadow:var(--shadow-hover)] group-hover/demo:[transform:translateY(-4px)]">
                              {demoItem.screenshot && (
                                <img src={withBase(demoItem.screenshot)} alt={`${demoTitle}${isZh ? '缩略图' : ' thumbnail'}`} loading="lazy" decoding="async" />
                              )}
                            </div>
                            <strong class="block truncate text-[16px] font-semibold text-center">{demoTitle}</strong>
                          </a>
                        );
                      })}
                    </div>
                  </section>
                ))}
              </section>
            );
          })}
        </div>
      </section>
    </div>
  )}

  {demo && (
    <div class="grid w-[var(--content-width)] mx-auto bg-[var(--surface-raised)] [@media(width<=900px)]:block [@media(width<=900px)]:w-[min(100%_-_36px,820px)] grid-cols-[250px_minmax(0,1fr)] h-full [@media(900px<width<=1320px)]:grid-cols-[240px_minmax(0,1fr)] [@media(width<=1080px)]:h-auto">
      <ExampleSidebar categories={registry.categories} locale={locale} currentRoute={page.route} />
      <article class="min-w-0 h-full p-0 overflow-hidden bg-[var(--surface-raised)] [@media(width<=1080px)]:h-auto [@media(width<=1080px)]:overflow-visible">
        <Demo
          demo={demo}
          locale={locale}
          height={config.demo.height}
        />
      </article>
    </div>
  )}

</BaseLayout>
