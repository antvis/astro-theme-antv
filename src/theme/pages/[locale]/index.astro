---
import { localize } from '../../../compiler/localization.js';
import arrowRightIcon from '@tabler/icons/outline/arrow-right.svg?raw';
import bracesIcon from '@tabler/icons/outline/braces.svg?raw';
import codeIcon from '@tabler/icons/outline/code.svg?raw';
import componentsIcon from '@tabler/icons/outline/components.svg?raw';
import Layout from '../../layouts/Layout.astro';
import QaEntry from '../../components/QaEntry.astro';
import { withBase } from '../../lib/paths';
import { config, registry } from '../../lib/site';
import { homeSlots } from 'virtual:antv-site-home-slots';

export function getStaticPaths() {
  return config.site.locales.map((locale) => ({ params: { locale } }));
}

// The root route shares this page and renders the configured default language.
const locale = (Astro.params['locale'] ?? config.site.defaultLocale) as 'zh' | 'en';
const home = config.home;
const route = `/${locale}/`;
const localHref = (href: string) => {
  if (
    href.startsWith('//') ||
    /^[a-z][a-z\d+.-]*:/i.test(href) ||
    href.startsWith('#')
  ) return href;
  if (href.startsWith(`/${locale}/`) || href === `/${locale}/`) return withBase(href);
  return withBase(
    `/${locale}${href.startsWith('/') ? href : `/${href}`}`.replace(/\/$/, '') + '/',
  );
};
const featureIcons = [bracesIcon, componentsIcon, codeIcon];
const imageAlt = localize(
  home.imageAlt,
  locale,
  locale === 'zh'
    ? `${config.site.title} 产品展示`
    : `${config.site.title} product showcase`,
);
---

<Layout locale={locale} title={config.site.title} description={localize(config.site.description, locale)} route={route} pageType="home" image={home.image} imageAlt={imageAlt} openGraph={home.openGraph}>
  {homeSlots.beforeHero.map((SlotComponent) => (
    <SlotComponent locale={locale} config={config} registry={registry} slotName="beforeHero" />
  ))}

  {homeSlots.hero.length > 0 ? (
    homeSlots.hero.map((SlotComponent) => (
      <SlotComponent locale={locale} config={config} registry={registry} slotName="hero" />
    ))
  ) : (
    <section class="home-hero relative isolate grid [grid-template-columns:minmax(360px,_0.78fr)_minmax(560px,_1.22fr)] w-[var(--home-content-width)] min-h-[calc(100dvh_-_var(--header-height))] items-center gap-[clamp(36px,_5vw,_78px)] pt-[clamp(46px,_7vh,_78px)] pb-[clamp(72px,_9vh,_100px)] text-left mx-auto my-0 px-0 [@media(width<=1080px)]:grid-cols-1 [@media(width<=1080px)]:min-h-auto [@media(width<=1080px)]:text-center [@media(width<=1080px)]:justify-items-center [@media(width<=700px)]:w-[calc(100%_-_24px)] [@media(width<=700px)]:gap-y-8.5 [@media(width<=700px)]:gap-x-8.5 [@media(width<=700px)]:pt-11 [@media(width<=700px)]:pb-18 [@media(700px<width<=1080px)]:gap-y-11 [@media(700px<width<=1080px)]:gap-x-11 [@media(700px<width<=1080px)]:pt-18 [@media(700px<width<=1080px)]:pb-24" aria-labelledby="home-title">
      <div class="relative z-2 grid max-w-160 justify-items-start pl-[clamp(0px,_1.2vw,_18px)] [@media(width<=1080px)]:max-w-190 [@media(width<=1080px)]:justify-items-center">
        <p class="mt-0 mr-0 mb-4 ml-0 text-[color-mix(in_srgb,var(--brand-strong)_88%,#5f78df)] text-[11px] font-semibold tracking-[0.14em] uppercase [font-family:SFMono-Regular,Consolas,monospace]">{localize(home.eyebrow, locale, `AntV ${config.site.title}`)}</p>
        <h1 id="home-title" class="grid gap-2.5 text-[var(--text-strong)] text-[clamp(46px,_4.2vw,_66px)] [font-weight:var(--font-heading-weight)] leading-[1.02] tracking-[-0.06em] m-0 [@media(700px<width<=900px)]:text-[48px] [@media(700px<width<=900px)]:max-w-170 [@media(width<=700px)]:text-[clamp(34px,_10vw,_40px)] [@media(width<=700px)]:leading-[1.05] [@media(width<=700px)]:max-w-115">
          <span class="flex items-baseline gap-[0.18em] whitespace-nowrap [@media(width<=700px)]:justify-center"><strong class="text-[var(--brand-strong)] [font:inherit]">{config.site.title}</strong></span>
          <span class="block max-w-[11em] text-[var(--text-strong)] text-[clamp(42px,_3.5vw,_56px)] whitespace-normal [@media(width<=700px)]:[font-size:inherit]">{localize(home.title, locale)}</span>
        </h1>
        <p class="max-w-127.5 mt-6 mb-0 text-[var(--muted)] text-[17px] leading-[1.72] mx-0 [@media(width<=900px)]:max-w-160 [@media(width<=900px)]:text-[16px]">{localize(home.description, locale)}</p>
        {config.qa && <QaEntry locale={locale} />}
        {home.actions.length > 0 && (
          <div class="flex flex-wrap gap-3.5 justify-start mt-7.5 [@media(width<=700px)]:grid [@media(width<=700px)]:grid-cols-1 [@media(width<=700px)]:w-[min(100%,_360px)] [@media(width<=1080px)]:justify-center [@media(width<=700px)]:[&_.button]:w-full">
            {home.actions.map((action, index) => (
              <a class:list={['button inline-flex min-h-12 items-center justify-center gap-2.5 py-0 px-5.5 rounded-xl text-[14px] font-semibold no-underline [transition:border-color_0.2s,box-shadow_0.2s,color_0.2s,transform_0.2s,background_0.2s]', index === 0 && 'button-primary']} href={localHref(action.href)}>
                <span>{localize(action.text, locale)}</span>
                {index === 0 && <span class="block w-4 h-4 [&_svg]:block [&_svg]:w-full [&_svg]:h-full [&_svg]:[stroke-width:1.8]" aria-hidden="true" set:html={arrowRightIcon}></span>}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="[transition:transform_0.3s_cubic-bezier(0.2,0.8,0.2,1)] relative z-1 block w-full max-w-190 [justify-self:end] [text-decoration:none] [@media(900px<width<=1080px)]:w-[min(100%,_780px)] [@media(700px<width<=900px)]:w-[min(100%,_760px)] [@media(width<=1080px)]:[justify-self:center] [@media(width<=700px)]:mt-0 [&:hover]:[transform:translateY(-5px)]">
        <div class="hero-showcase-frame relative block overflow-hidden [border:1px_solid_var(--home-border)] rounded-[24px] p-[clamp(18px,_2.2vw,_28px)] [@media(width<=700px)]:rounded-[18px] [@media(width<=700px)]:p-3.5">
          {home.image ? (
            <img class="relative z-1 block w-full min-h-105 max-h-140 object-contain [@media(width<=700px)]:min-h-70" src={withBase(home.image)} alt={imageAlt} decoding="async" />
          ) : (
            <div class="hero-default-visual relative z-1 grid min-h-115 place-items-center overflow-hidden text-[var(--brand)] [@media(width<=700px)]:min-h-70 [&_svg]:absolute [&_svg]:[inset:0] [&_svg]:w-full [&_svg]:h-full [&_svg]:[fill:var(--surface-raised)] [&_svg]:[stroke:var(--brand)] [&_svg]:[stroke-linecap:round] [&_svg]:[stroke-linejoin:round] [&_svg]:[stroke-width:5] [&_circle]:[stroke:var(--brand)] [&_circle]:[stroke-width:5]" aria-hidden="true">
              <span class="hero-product-mark relative z-2 grid min-w-31 min-h-31 place-items-center [border:1px_solid_color-mix(in_srgb,_var(--brand)_24%,_var(--border))] rounded-[34px] text-[var(--brand-strong)] text-[clamp(28px,_4vw,_48px)] font-bold tracking-[-0.06em] p-5 [@media(width<=700px)]:min-w-23 [@media(width<=700px)]:min-h-23 [@media(width<=700px)]:rounded-[24px]">{config.site.title}</span>
              <svg viewBox="0 0 720 500">
                <path d="M72 386 C154 316 208 348 278 250 S420 120 492 202 S586 294 650 104"></path>
                <path d="M92 410 C180 374 222 294 318 320 S474 376 628 170"></path>
                <g>
                  <circle cx="72" cy="386" r="10"></circle>
                  <circle cx="278" cy="250" r="12"></circle>
                  <circle cx="492" cy="202" r="12"></circle>
                  <circle cx="650" cy="104" r="10"></circle>
                  <circle cx="92" cy="410" r="8"></circle>
                  <circle cx="318" cy="320" r="11"></circle>
                  <circle cx="628" cy="170" r="9"></circle>
                </g>
              </svg>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {homeSlots.afterHero.map((SlotComponent) => (
    <SlotComponent locale={locale} config={config} registry={registry} slotName="afterHero" />
  ))}

  {homeSlots.beforeFeatures.map((SlotComponent) => (
    <SlotComponent locale={locale} config={config} registry={registry} slotName="beforeFeatures" />
  ))}

  {homeSlots.features.length > 0 ? (
    homeSlots.features.map((SlotComponent) => (
      <SlotComponent locale={locale} config={config} registry={registry} slotName="features" />
    ))
  ) : home.features.length > 0 && (
    <section class="feature-section relative w-full mt-18 mb-0 pt-29.5 pb-32 overflow-hidden mx-auto px-7 [@media(width<=700px)]:mt-13 [@media(width<=700px)]:pt-18 [@media(width<=700px)]:pb-21 [@media(width<=700px)]:px-3" aria-labelledby="feature-title">
      <header class="relative z-1 max-w-180 mt-0 mb-14 text-center mx-auto [@media(width<=700px)]:mb-7.5 [&_p]:max-w-140 [&_p]:mt-4.5 [&_p]:mb-0 [&_p]:text-[var(--muted)] [&_p]:text-[16px] [&_p]:leading-[1.7] [&_p]:mx-auto">
        <h2 id="feature-title" class="text-[var(--text-strong)] text-[clamp(36px,_3.3vw,_48px)] [font-weight:var(--font-heading-weight)] leading-[1.18] tracking-[-0.045em] m-0 [@media(width<=700px)]:text-[32px]">
          {localize(
            home.featuresTitle,
            locale,
            locale === 'zh' ? '文档与示例，保持简单' : 'Documentation and examples, kept simple',
          )}
        </h2>
        <p>{localize(home.featuresDescription, locale, '')}</p>
      </header>
      <div class="feature-list relative z-1 grid grid-cols-2 [grid-template-rows:auto] w-[var(--home-content-width)] gap-5 mx-auto my-0 [@media(width<=700px)]:grid-cols-1 [@media(width<=700px)]:w-full [&_h3]:mt-6.5 [&_h3]:mb-3 [&_h3]:text-[var(--text-strong)] [&_h3]:text-[clamp(22px,_2vw,_28px)] [&_h3]:font-bold [&_h3]:tracking-[-0.035em] [&_h3]:mx-0 [&_p]:max-w-[40ch] [&_p]:text-[var(--muted)] [&_p]:text-[15px] [&_p]:leading-[1.78] [&_p]:m-0">
        {home.features.map((feature, index) => (
          <article class:list={[
            `feature-card-${index + 1}`,
            'relative overflow-hidden rounded-[22px] text-left [transition:border-color_0.25s_ease,box-shadow_0.3s_ease,transform_0.3s_cubic-bezier(0.2,0.8,0.2,1)]',
            index === 0
              ? 'col-span-full min-h-[290px] p-[clamp(40px,4vw,54px)] [@media(width<=700px)]:col-auto [@media(width<=700px)]:pt-8.5 [@media(width<=700px)]:px-7 [@media(width<=700px)]:pb-9.5'
              : 'min-h-0 pt-9 px-9.5 pb-10 [@media(700px<width<=900px)]:pt-8.5 [@media(700px<width<=900px)]:px-7 [@media(700px<width<=900px)]:pb-11 [@media(width<=700px)]:pt-7.5 [@media(width<=700px)]:px-6.5 [@media(width<=700px)]:pb-8.5',
          ]}>
            <span class="feature-symbol grid w-12 h-12 place-items-center [border:1px_solid_color-mix(in_srgb,_var(--brand)_20%,_var(--border))] rounded-[14px] text-[var(--brand-strong)] [&_svg]:block [&_svg]:w-5.5 [&_svg]:h-5.5 [&_svg]:[stroke-width:1.7] [&_>_span]:grid [&_>_span]:place-items-center [&_img]:block [&_img]:w-7 [&_img]:h-7 [&_img]:object-contain" aria-hidden="true">
              {feature.icon ? (
                <img src={withBase(feature.icon)} alt="" loading="lazy" decoding="async" />
              ) : (
                <span set:html={featureIcons[index % featureIcons.length]}></span>
              )}
            </span>
            <h3>{localize(feature.title, locale)}</h3>
            <p>{localize(feature.description, locale)}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {homeSlots.afterFeatures.map((SlotComponent) => (
    <SlotComponent locale={locale} config={config} registry={registry} slotName="afterFeatures" />
  ))}

  {homeSlots.beforeFooter.map((SlotComponent) => (
    <SlotComponent locale={locale} config={config} registry={registry} slotName="beforeFooter" />
  ))}
</Layout>

<style>
  /* Default homepage decoration; layout and interaction utilities stay above. */
  .home-hero::before,
  .home-hero::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .home-hero::before {
    top: 5%;
    right: -13%;
    width: min(72vw, 980px);
    aspect-ratio: 1.28;
    border-radius: 44%;
    background:
      radial-gradient(
        circle at 65% 22%,
        color-mix(in srgb, #7c9cff 28%, transparent),
        transparent 24%
      ),
      radial-gradient(
        circle at 34% 42%,
        color-mix(in srgb, var(--brand) 24%, transparent),
        transparent 34%
      ),
      radial-gradient(
        circle at 72% 70%,
        color-mix(in srgb, #c3a6ff 25%, transparent),
        transparent 30%
      );
    filter: blur(18px);
    opacity: 0.74;
    transform: rotate(-7deg);
  }

  .home-hero::after {
    right: 2%;
    bottom: 7%;
    width: min(52vw, 720px);
    height: 66%;
    border-radius: 36px;
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--brand) 7%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--brand) 7%, transparent) 1px,
        transparent 1px
      );
    background-size: 36px 36px;
    mask-image: linear-gradient(
      135deg,
      transparent 4%,
      #000 44%,
      transparent 94%
    );
    opacity: 0.65;
  }

  .button {
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 68%),
      0 8px 24px rgb(64 49 108 / 6%);
    color: var(--text-strong);
  }

  .button:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--border));
    background: var(--surface-raised);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 72%),
      0 14px 30px rgb(64 49 108 / 10%);
    color: var(--brand-strong);
    transform: translateY(-2px);
  }

  .button:active {
    transform: translateY(0) scale(0.98);
  }

  .button-primary {
    border-color: color-mix(in srgb, var(--brand-strong) 88%, #5578f5);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand) 88%, #5578f5),
      var(--brand-strong)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 24%),
      0 14px 30px color-mix(in srgb, var(--brand) 24%, transparent);
    color: #ffffff;
  }

  .button-primary:hover {
    border-color: var(--brand);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand) 94%, #5578f5),
      var(--brand-strong)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 28%),
      0 18px 36px color-mix(in srgb, var(--brand) 30%, transparent);
    color: #ffffff;
  }

  .hero-showcase-frame {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--surface-raised) 88%, transparent),
        color-mix(in srgb, var(--surface-raised) 66%, transparent)
      ),
      var(--home-surface);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 86%),
      inset 0 -1px 0 rgb(112 71 225 / 5%),
      var(--home-shadow);
    backdrop-filter: blur(22px) saturate(118%);
  }

  .hero-showcase-frame::before {
    position: absolute;
    top: -30%;
    right: -14%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    filter: blur(54px);
    content: "";
    pointer-events: none;
  }

  .hero-showcase-frame::after {
    position: absolute;
    top: -42%;
    left: -18%;
    width: 54%;
    height: 170%;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgb(255 255 255 / 46%) 48%,
      transparent 72%
    );
    content: "";
    opacity: 0.48;
    pointer-events: none;
    transform: rotate(8deg);
  }

  .hero-default-visual::before {
    position: absolute;
    width: 68%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--brand) 14%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 0 48px color-mix(in srgb, var(--brand) 4%, transparent),
      0 0 0 112px color-mix(in srgb, var(--brand) 3%, transparent);
    content: "";
  }

  .hero-product-mark {
    background: color-mix(in srgb, var(--surface-raised) 86%, transparent);
    box-shadow: 0 28px 70px color-mix(in srgb, var(--brand) 20%, transparent);
    backdrop-filter: blur(16px);
  }

  .feature-section {
    background:
      linear-gradient(
        color-mix(in srgb, var(--brand) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--brand) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--brand-faint) 80%, transparent),
        transparent 92%
      );
    background-size:
      48px 48px,
      48px 48px,
      auto;
  }

  .feature-section::before,
  .feature-section::after {
    position: absolute;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand) 10%, transparent);
    content: "";
    filter: blur(54px);
    pointer-events: none;
  }

  .feature-section::before {
    top: 8%;
    left: -8%;
    width: 320px;
    height: 320px;
  }

  .feature-section::after {
    right: -7%;
    bottom: 4%;
    width: 360px;
    height: 360px;
  }

  .feature-list article {
    border: 1px solid var(--home-border);
    background: var(--home-surface);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 68%),
      0 20px 52px rgb(69 49 126 / 8%);
    backdrop-filter: blur(16px) saturate(112%);
  }

  .feature-card-1 {
    background:
      radial-gradient(
        circle at 84% 18%,
        color-mix(in srgb, var(--brand) 18%, transparent),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--surface-raised) 92%, transparent),
        color-mix(in srgb, var(--brand-faint) 88%, transparent)
      );
  }

  .feature-card-2 {
    background:
      radial-gradient(
        circle at 88% 14%,
        color-mix(in srgb, #7995ff 15%, transparent),
        transparent 34%
      ),
      var(--home-surface);
  }

  .feature-card-3 {
    background:
      radial-gradient(
        circle at 86% 18%,
        color-mix(in srgb, #bd8cff 15%, transparent),
        transparent 34%
      ),
      var(--home-surface);
  }

  .feature-list article:hover {
    border-color: color-mix(in srgb, var(--brand) 32%, var(--border));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 72%),
      0 28px 62px rgb(69 49 126 / 13%);
    transform: translateY(-6px);
  }

  .feature-symbol {
    background: color-mix(in srgb, var(--surface-raised) 74%, var(--brand-soft));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 80%),
      0 10px 22px color-mix(in srgb, var(--brand) 11%, transparent);
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero-showcase-frame,
    .feature-list article {
      background: var(--surface-raised);
      backdrop-filter: none;
    }
  }

  @media (max-width: 1080px) {
    .home-hero::before {
      top: 20%;
      right: -20%;
      width: 110%;
    }

    .home-hero::after {
      right: 8%;
      bottom: 2%;
      width: 84%;
      height: 48%;
    }
  }
</style>
