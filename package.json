{
  "name": "@antv/site",
  "version": "0.1.0",
  "description": "Astro integration for static open-source documentation and examples",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./qa": {
      "types": "./theme/src/features/qa/index.ts",
      "import": "./theme/src/features/qa/index.ts"
    },
    "./qa-entry": {
      "types": "./theme/src/components/QaEntry.astro",
      "import": "./theme/src/components/QaEntry.astro"
    }
  },
  "files": [
    "dist",
    "theme/src",
    "theme/tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/rewrite-imports.mjs",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "pnpm run test",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/sitemap": "3.7.3",
    "@tabler/icons": "^3.46.0",
    "dompurify": "3.4.14",
    "gray-matter": "4.0.3",
    "highlight.js": "11.12.0",
    "marked": "18.0.9",
    "pagefind": "1.5.2",
    "vite": "8.2.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "astro": ">=7.2.0 <8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.18.6",
    "astro": "7.2.0",
    "typescript": "5.9.3"
  }
}
